<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/universityCard"
    android:layout_width="match_parent"
    android:layout_height="@dimen/_64sdp"
    android:layout_marginBottom="@dimen/_5sdp"
    app:cardBackgroundColor="@color/home_card_background"
    app:cardCornerRadius="@dimen/_9sdp"
    app:cardElevation="1dp"
    app:strokeColor="@color/home_card_border"
    app:strokeWidth="1dp">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/_8sdp"
        android:paddingEnd="@dimen/_8sdp">


        <!-- University Logo -->
        <ImageView
            android:id="@+id/universityLogo"
            android:layout_width="@dimen/_42sdp"
            android:layout_height="@dimen/_42sdp"
            android:padding="@dimen/_3sdp"
            android:src="@drawable/du_icon"
            android:scaleType="centerInside"
            android:contentDescription="@null" />


        <!-- University Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/_10sdp">


            <TextView
                android:id="@+id/universityName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dhaka University"
                android:textColor="@color/home_card_title"
                android:textSize="@dimen/_12ssp"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/universityUnits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:text="A Unit, B Unit, C Unit"
                android:textColor="@color/home_card_subtitle"
                android:textSize="@dimen/_9ssp" />

        </LinearLayout>


        <!-- Arrow -->
        <ImageView
            android:id="@+id/arrowIcon"
            android:layout_width="@dimen/_28sdp"
            android:layout_height="@dimen/_28sdp"
            android:padding="@dimen/_7sdp"
            android:src="@drawable/ic_arrow_forward"
            app:tint="@color/home_card_subtitle"
            android:contentDescription="@null" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>