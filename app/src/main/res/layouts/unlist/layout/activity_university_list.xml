<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    tools:context=".presentation.unlist.UniversityListActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/_16sdp"
        android:paddingEnd="@dimen/_16sdp">


        <!-- Toolbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_60sdp"
            android:gravity="center_vertical"
            android:orientation="horizontal">


            <!-- Back Button -->
            <ImageView
                android:id="@+id/backButton"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                android:padding="@dimen/_9sdp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/back_arrow_color"
                android:contentDescription="Back" />


            <!-- Title -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/_8sdp"
                android:text="Choose University"
                android:textColor="@color/tittle_card"
                android:textSize="@dimen/_16ssp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- Search -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="@dimen/_44sdp"
            android:layout_marginTop="@dimen/_4sdp"
            android:layout_marginBottom="@dimen/_10sdp"
            app:cardBackgroundColor="@color/home_card_background"
            app:cardCornerRadius="@dimen/_9sdp"
            app:cardElevation="1dp"
            app:strokeColor="@color/home_card_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/_12sdp"
                android:paddingEnd="@dimen/_12sdp">


                <ImageView
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:src="@drawable/ic_search"
                    app:tint="@color/home_card_subtitle"
                    android:contentDescription="@null" />


                <EditText
                    android:id="@+id/searchEditText"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:background="@null"
                    android:hint="Search university..."
                    android:textColor="@color/home_card_title"
                    android:textColorHint="@color/home_card_subtitle"
                    android:textSize="@dimen/_12ssp"
                    android:singleLine="true"
                    android:inputType="text"
                    android:padding="0dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- University List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/universityRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/_16sdp"
            android:overScrollMode="never" />


        <!-- সার্চ রেজাল্ট না পেলে এই টেক্সট ভিউটি দেখাবে -->
        <TextView
            android:id="@+id/noResultTextView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:layout_marginTop="@dimen/_20sdp"
            android:text="No university found!"
            android:textSize="@dimen/_14ssp"
            android:textColor="@color/home_card_subtitle"
            android:visibility="gone" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>