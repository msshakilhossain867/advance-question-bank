<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    tools:context=".presentation.fragments.ProgressFragment"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/_11sdp">

        <!-- ================================================= -->
        <!-- TITLE -->
        <!-- ================================================= -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Progress"
            android:textSize="@dimen/_20ssp"
            android:textStyle="bold"
            android:textColor="@color/home_text_primary"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:text="Overall progress • Last 7 days"
            android:textSize="@dimen/_12ssp"
            android:textColor="@color/home_card_subtitle"/>


        <!-- ================================================= -->
        <!-- SUMMARY CARD -->
        <!-- ================================================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_20sdp"
            android:orientation="horizontal">

            <!-- Reading -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="@dimen/_100sdp"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/_6sdp"
                android:gravity="center"
                android:orientation="vertical"
                android:background="@drawable/bg_progress_card">

                <TextView
                    android:id="@+id/readingTotalText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="@dimen/_20ssp"
                    android:textStyle="bold"
                    android:textColor="@color/home_card_title"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reading"
                    android:textSize="@dimen/_13ssp"
                    android:textColor="@color/home_card_subtitle"/>

            </LinearLayout>

            <!-- Practice -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="@dimen/_100sdp"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/_3sdp"
                android:layout_marginEnd="@dimen/_3sdp"
                android:gravity="center"
                android:orientation="vertical"
                android:background="@drawable/bg_progress_card">

                <TextView
                    android:id="@+id/practiceTotalText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="@dimen/_20ssp"
                    android:textStyle="bold"
                    android:textColor="@color/home_card_title"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Practice"
                    android:textSize="@dimen/_13ssp"
                    android:textColor="@color/home_card_subtitle"/>

            </LinearLayout>

            <!-- Mock -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="@dimen/_100sdp"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/_6sdp"
                android:gravity="center"
                android:orientation="vertical"
                android:background="@drawable/bg_progress_card">

                <TextView
                    android:id="@+id/mockTotalText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="@dimen/_20ssp"
                    android:textStyle="bold"
                    android:textColor="@color/home_card_title"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mock Test"
                    android:textSize="@dimen/_13ssp"
                    android:textColor="@color/home_card_subtitle"/>

            </LinearLayout>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- ACTIVITY HORIZONTAL BAR CHART -->
        <!-- ================================================= -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_28sdp"
            android:text="Daily Activity"
            android:textSize="@dimen/_13ssp"
            android:textStyle="bold"
            android:textColor="@color/home_text_primary"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reading • Practice • Mock Test"
            android:textSize="@dimen/_11ssp"
            android:textColor="@color/home_card_subtitle"/>

        <com.github.mikephil.charting.charts.HorizontalBarChart
            android:id="@+id/activityChart"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_280sdp"
            android:layout_marginTop="@dimen/_10sdp"/>


        <!-- ================================================= -->
        <!-- PERFORMANCE DONUT / PIE CHART -->
        <!-- ================================================= -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_28sdp"
            android:text="Performance"
            android:textSize="@dimen/_13ssp"
            android:textStyle="bold"
            android:textColor="@color/home_text_primary"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Correct • Wrong • Skipped"
            android:textSize="@dimen/_11ssp"
            android:textColor="@color/home_card_subtitle"/>

        <com.github.mikephil.charting.charts.PieChart
            android:id="@+id/performanceChart"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_280sdp"
            android:layout_marginTop="@dimen/_10sdp"/>


        <!-- ================================================= -->

        <!-- ================================================= -->
        <TextView
            android:id="@+id/overallSuccessText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_20sdp"
            android:gravity="center"
            android:text="Overall Success Rate: 0%"
            android:textSize="@dimen/_15ssp"
            android:textStyle="bold"
            android:textColor="@color/home_card_title"/>

        <!-- সাফল্যের হারের জন্য ছোট এবং আকর্ষণীয় ডোনাট চার্ট -->
        <com.github.mikephil.charting.charts.PieChart
            android:id="@+id/successRateChart"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_160sdp"
            android:layout_marginTop="@dimen/_10sdp"/>

    </LinearLayout>

</ScrollView>