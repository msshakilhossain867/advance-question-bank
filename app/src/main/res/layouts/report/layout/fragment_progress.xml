<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".presentation.report.ProgressFragment"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ================================================= -->
        <!-- TITLE -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Progress"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#222222"/>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Overall progress • Last 7 days"
            android:textSize="14sp"
            android:textColor="#777777"/>


        <!-- ================================================= -->
        <!-- SUMMARY CARD -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <!-- Reading -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:gravity="center"
                android:orientation="vertical"
                android:background="@drawable/bg_progress_card">

                <TextView
                    android:id="@+id/readingTotalText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="25sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reading"
                    android:textSize="13sp"/>

            </LinearLayout>


            <!-- Practice -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:gravity="center"
                android:orientation="vertical"
                android:background="@drawable/bg_progress_card">

                <TextView
                    android:id="@+id/practiceTotalText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="25sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Practice"
                    android:textSize="13sp"/>

            </LinearLayout>


            <!-- Mock -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:orientation="vertical"
                android:background="@drawable/bg_progress_card">

                <TextView
                    android:id="@+id/mockTotalText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="25sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mock Test"
                    android:textSize="13sp"/>

            </LinearLayout>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- ACTIVITY GRAPH -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Daily Activity"
            android:textSize="20sp"
            android:textStyle="bold"/>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reading • Practice • Mock Test"
            android:textSize="13sp"
            android:textColor="#777777"/>


        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/activityChart"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:layout_marginTop="10dp"/>


        <!-- ================================================= -->
        <!-- PERFORMANCE GRAPH -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Performance"
            android:textSize="20sp"
            android:textStyle="bold"/>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Correct • Wrong • Skipped"
            android:textSize="13sp"
            android:textColor="#777777"/>


        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/performanceChart"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:layout_marginTop="10dp"/>


        <!-- ================================================= -->
        <!-- SUCCESS RATE -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/overallSuccessText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="Overall Success Rate: 0%"
            android:textSize="18sp"
            android:textStyle="bold"/>

    </LinearLayout>

</ScrollView>