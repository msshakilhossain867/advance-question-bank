<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/screen_background"
    tools:context=".presentation.questionview.QuestionsActivity">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/_11sdp"
        android:orientation="vertical">

        <!-- Top Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_58sdp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/backButton"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                android:padding="@dimen/_9sdp"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Back"
                app:tint="@color/back_arrow_color" />

            <TextView
                android:id="@+id/questionNumber"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="12 / 45"
                android:textColor="@color/home_card_title"
                android:textSize="@dimen/_14ssp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/bookmarkButton"
                android:layout_width="@dimen/_44sdp"
                android:layout_height="@dimen/_44sdp"
                android:padding="@dimen/_9sdp"
                android:src="@drawable/ic_bookmark_border"
                android:contentDescription="Bookmark"
                app:tint="@color/back_arrow_color" />

        </LinearLayout>


        <!-- Question Area -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/nestedScrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="@dimen/_10sdp"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="@dimen/_4sdp"
                android:paddingBottom="@dimen/_20sdp"
                tools:ignore="WebViewLayout">

                <!-- Subject -->
                <TextView
                    android:id="@+id/subjectText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Physics"
                    android:textColor="@color/home_card_title"
                    android:textSize="@dimen/_15ssp"
                    android:textStyle="bold" />

                <!-- Topic -->
                <TextView
                    android:id="@+id/topicText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Keep reading"
                    android:textColor="@color/home_card_subtitle"
                    android:textSize="@dimen/_11ssp"
                    android:layout_marginTop="@dimen/_2sdp" />


                <!-- Question -->
                <WebView
                    android:id="@+id/questionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:layout_marginBottom="@dimen/_14sdp"
                    android:background="@android:color/transparent"
                    android:overScrollMode="never"
                    android:scrollbars="none"
                    android:visibility="gone" />

                <!-- সাধারণ প্রশ্নের জন্য TextView -->
                <TextView
                    android:id="@+id/questionTv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:layout_marginBottom="@dimen/_14sdp"
                    android:textColor="@color/home_card_title"
                    android:textSize="@dimen/_15ssp"
                    android:textStyle="bold"
                    android:visibility="gone" />


                <!-- Option 1 -->
                <WebView
                    android:id="@+id/option1"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_48sdp"
                    android:layout_marginBottom="@dimen/_8sdp"
                    android:background="@drawable/bg_option_normal"
                    android:overScrollMode="never"
                    android:scrollbars="none" />

                <TextView
                    android:id="@+id/option1Tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/_48sdp"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/_12sdp"
                    android:paddingEnd="@dimen/_12sdp"
                    android:layout_marginBottom="@dimen/_8sdp"
                    android:background="@drawable/bg_option_normal"
                    android:textColor="@color/home_card_title"
                    android:textSize="@dimen/_14ssp"
                    android:visibility="gone" />


                <!-- Option 2 -->
                <WebView
                    android:id="@+id/option2"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_48sdp"
                    android:layout_marginBottom="@dimen/_8sdp"
                    android:background="@drawable/bg_option_normal"
                    android:overScrollMode="never"
                    android:scrollbars="none" />

                <TextView
                    android:id="@+id/option2Tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/_48sdp"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/_12sdp"
                    android:paddingEnd="@dimen/_12sdp"
                    android:layout_marginBottom="@dimen/_8sdp"
                    android:background="@drawable/bg_option_normal"
                    android:textColor="@color/home_card_title"
                    android:textSize="@dimen/_14ssp"
                    android:visibility="gone" />


                <!-- Option 3 -->
                <WebView
                    android:id="@+id/option3"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_48sdp"
                    android:layout_marginBottom="@dimen/_8sdp"
                    android:background="@drawable/bg_option_correct"
                    android:overScrollMode="never"
                    android:scrollbars="none" />

                <TextView
                    android:id="@+id/option3Tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/_48sdp"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/_12sdp"
                    android:paddingEnd="@dimen/_12sdp"
                    android:layout_marginBottom="@dimen/_8sdp"
                    android:background="@drawable/bg_option_normal"
                    android:textColor="@color/home_card_title"
                    android:textSize="@dimen/_14ssp"
                    android:visibility="gone" />


                <!-- Option 4 -->
                <WebView
                    android:id="@+id/option4"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_48sdp"
                    android:layout_marginBottom="@dimen/_18sdp"
                    android:background="@drawable/bg_option_normal"
                    android:overScrollMode="never"
                    android:scrollbars="none" />

                <TextView
                    android:id="@+id/option4Tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/_48sdp"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/_12sdp"
                    android:paddingEnd="@dimen/_12sdp"
                    android:layout_marginBottom="@dimen/_8sdp"
                    android:background="@drawable/bg_option_normal"
                    android:textColor="@color/home_card_title"
                    android:textSize="@dimen/_14ssp"
                    android:visibility="gone" />


                <!-- Explanation -->
                <LinearLayout
                    android:id="@+id/explanationLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/_14sdp"
                    android:background="@drawable/ic_ex"
                    tools:ignore="WebViewLayout">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Explanation"
                        android:textColor="@color/home_card_title"
                        android:textSize="@dimen/_14ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/correctAnswer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="সঠিক উত্তর"
                        android:textColor="@color/home_card_title"
                        android:textSize="@dimen/_14ssp"
                        android:textStyle="bold" />

                    <WebView
                        android:id="@+id/explanationText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_6sdp"
                        android:background="@android:color/transparent"
                        android:overScrollMode="never"
                        android:scrollbars="none" />

                </LinearLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>


        <!-- Bottom Navigation -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_68sdp"
            android:paddingStart="@dimen/_10sdp"
            android:paddingEnd="@dimen/_10sdp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="@dimen/_8sdp"
            android:paddingBottom="@dimen/_10sdp">

            <!-- Previous -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/previousButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/_46sdp"
                android:layout_weight="1"
                android:text="Previous"
                android:textSize="@dimen/_13ssp"
                android:textStyle="bold"
                android:textColor="@color/home_card_title"
                android:textAllCaps="false"
                android:backgroundTint="@color/home_card_background"
                app:cornerRadius="@dimen/_8sdp"
                app:strokeColor="@color/home_card_border"
                app:strokeWidth="1dp" />

            <Space
                android:layout_width="@dimen/_10sdp"
                android:layout_height="@dimen/_1sdp" />

            <!-- Next -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/nextButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/_46sdp"
                android:layout_weight="1"
                android:text="Next"
                android:textSize="@dimen/_13ssp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:textAllCaps="false"
                android:backgroundTint="#1764BD"
                app:cornerRadius="@dimen/_8sdp" />

        </LinearLayout>

    </LinearLayout>



</LinearLayout>