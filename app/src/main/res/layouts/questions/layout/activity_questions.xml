<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAFBFD"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    tools:context=".presentation.questionview.QuestionsActivity">




        <!-- Top Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/backButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="9dp"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Back"
                app:tint="#1858A8" />

            <TextView
                android:id="@+id/questionNumber"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="12 / 45"
                android:textColor="#202020"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/bookmarkButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="9dp"
                android:src="@drawable/ic_bookmark_border"
                android:contentDescription="Bookmark"
                app:tint="#1858A8" />

        </LinearLayout>


        <!-- Question Area -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/nestedScrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="10dp"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="20dp">

                <!-- Subject -->
                <TextView
                    android:id="@+id/subjectText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Physics"
                    android:textColor="#161616"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Topic -->
                <TextView
                    android:id="@+id/topicText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Keep reading"
                    android:textColor="#666666"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />









                <!-- Question -->
                <WebView
                    android:id="@+id/questionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="14dp"
                    android:background="@android:color/transparent"
                    android:overScrollMode="never"
                    android:scrollbars="none"
                    android:visibility="gone" />

                <!-- সাধারণ প্রশ্নের জন্য TextView (সুপার ফাস্ট!) -->
                <TextView
                    android:id="@+id/questionTv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="14dp"
                    android:textColor="#151515"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:visibility="gone" />


                <!-- Option 1 -->
                <WebView
                    android:id="@+id/option1"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_option_normal"
                    android:overScrollMode="never"
                    android:scrollbars="none" />

                <TextView
                    android:id="@+id/option1Tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_option_normal"
                    android:textColor="#222222"
                    android:textSize="14sp"
                    android:visibility="gone" />


                <!-- Option 1 -->



                <!-- Option 2 -->
                <WebView
                    android:id="@+id/option2"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_option_normal"
                    android:overScrollMode="never"
                    android:scrollbars="none" />

                <TextView
                    android:id="@+id/option2Tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_option_normal"
                    android:textColor="#222222"
                    android:textSize="14sp"
                    android:visibility="gone" />


                <!-- Correct Option -->
                <WebView
                    android:id="@+id/option3"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_option_correct"
                    android:overScrollMode="never"
                    android:scrollbars="none" />

                <TextView
                    android:id="@+id/option3Tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_option_normal"
                    android:textColor="#222222"
                    android:textSize="14sp"
                    android:visibility="gone" />


                <!-- Option 4 -->
                <WebView
                    android:id="@+id/option4"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="18dp"
                    android:background="@drawable/bg_option_normal"
                    android:overScrollMode="never"
                    android:scrollbars="none" />

                <TextView
                    android:id="@+id/option4Tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_option_normal"
                    android:textColor="#222222"
                    android:textSize="14sp"
                    android:visibility="gone" />


                <!-- Explanation -->
                <LinearLayout
                    android:id="@+id/explanationLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:background="@drawable/ic_ex"
                    tools:ignore="WebViewLayout">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Explanation"
                        android:textColor="#1858A8"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/correctAnswer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="সঠিক উত্তর"
                        android:textColor="#1858A8"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <WebView
                        android:id="@+id/explanationText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@android:color/transparent"
                        android:overScrollMode="never"
                        android:scrollbars="none" />

                </LinearLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>


        <!-- Bottom Navigation -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp"
            android:paddingBottom="10dp">

            <!-- Previous -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/previousButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="Previous"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#1858A8"
                android:textAllCaps="false"
                android:backgroundTint="@android:color/white"
                app:cornerRadius="8dp"
                app:strokeColor="#72A7E2"
                app:strokeWidth="1dp" />

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <!-- Next -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/nextButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="Next"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:textAllCaps="false"
                android:backgroundTint="#1764BD"
                app:cornerRadius="8dp" />

        </LinearLayout>



</LinearLayout>