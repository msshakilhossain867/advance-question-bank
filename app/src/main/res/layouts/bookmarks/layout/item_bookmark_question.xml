<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/_12sdp"
    android:layout_marginEnd="@dimen/_12sdp"
    android:layout_marginTop="@dimen/_8sdp"
    android:layout_marginBottom="@dimen/_8sdp"
    app:cardCornerRadius="@dimen/_16sdp"
    app:cardElevation="1dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/home_card_border"
    app:cardBackgroundColor="@color/home_card_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/_16sdp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/questionNumber"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Question 1"
                android:textColor="#6254E8"
                android:textSize="@dimen/_14ssp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/removeBookmarkButton"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Remove bookmark"
                android:padding="@dimen/_8sdp"
                android:src="@drawable/ic_bookmark_filled"
                app:tint="#6254E8" />

        </LinearLayout>


        <!-- Year / Topic -->
        <TextView
            android:id="@+id/topicText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:text="2025"
            android:textColor="@color/home_card_subtitle"
            android:textSize="@dimen/_12ssp" />


        <!-- Question (TextView & WebView Mix) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12sdp">

            <TextView
                android:id="@+id/questionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Question text"
                android:textColor="@color/home_card_title"
                android:textSize="@dimen/_16ssp"
                android:textStyle="bold"
                android:visibility="visible" />

            <WebView
                android:id="@+id/questionWebView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </FrameLayout>


        <!-- Options A -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_14sdp"
            android:background="@drawable/bg_bookmark_option">

            <TextView
                android:id="@+id/optionAText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/_12sdp"
                android:text="A. Option A"
                android:textColor="@color/home_card_title"
                android:textSize="@dimen/_14ssp"
                android:visibility="visible" />

            <WebView
                android:id="@+id/optionAWebView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </FrameLayout>


        <!-- Options B -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:background="@drawable/bg_bookmark_option">

            <TextView
                android:id="@+id/optionBText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/_12sdp"
                android:text="B. Option B"
                android:textColor="@color/home_card_title"
                android:textSize="@dimen/_14ssp"
                android:visibility="visible" />

            <WebView
                android:id="@+id/optionBWebView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </FrameLayout>


        <!-- Options C -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:background="@drawable/bg_bookmark_option">

            <TextView
                android:id="@+id/optionCText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/_12sdp"
                android:text="C. Option C"
                android:textColor="@color/home_card_title"
                android:textSize="@dimen/_14ssp"
                android:visibility="visible" />

            <WebView
                android:id="@+id/optionCWebView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </FrameLayout>


        <!-- Options D -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:background="@drawable/bg_bookmark_option">

            <TextView
                android:id="@+id/optionDText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/_12sdp"
                android:text="D. Option D"
                android:textColor="@color/home_card_title"
                android:textSize="@dimen/_14ssp"
                android:visibility="visible" />

            <WebView
                android:id="@+id/optionDWebView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </FrameLayout>


        <!-- Correct Answer -->
        <LinearLayout
            android:id="@+id/correctAnswerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_14sdp"
            android:background="@drawable/bg_bookmark_correct"
            android:orientation="vertical"
            android:padding="@dimen/_12sdp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✓ সঠিক উত্তর"
                android:textColor="#238347"
                android:textSize="@dimen/_13ssp"
                android:textStyle="bold" />

            <!-- TextView & WebView Mix for Correct Answer -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4sdp">

                <TextView
                    android:id="@+id/correctAnswerText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="A. Correct answer"
                    android:textColor="#238347"
                    android:textSize="@dimen/_14ssp"
                    android:textStyle="bold"
                    android:visibility="visible" />

                <WebView
                    android:id="@+id/correctAnswerWebView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />
            </FrameLayout>

        </LinearLayout>


        <!-- Explanation -->
        <LinearLayout
            android:id="@+id/explanationLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:background="@drawable/bg_bookmark_explanation"
            android:orientation="vertical"
            android:padding="@dimen/_12sdp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💡 ব্যাখ্যা"
                android:textColor="#5B4DB8"
                android:textSize="@dimen/_13ssp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp">

                <TextView
                    android:id="@+id/explanationText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Explanation"
                    android:textColor="@color/home_card_subtitle"
                    android:textSize="@dimen/_14ssp"
                    android:visibility="visible" />

                <WebView
                    android:id="@+id/explanationWebView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />
            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>