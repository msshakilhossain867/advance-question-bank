<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/screen_background"

    tools:context=".presentation.units.UnitsActivity">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/_13sdp"
        android:orientation="vertical"
        android:paddingEnd="@dimen/_13sdp">

        <!-- Toolbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_64sdp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Back Button -->
            <ImageView
                android:id="@+id/backButton"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                android:padding="@dimen/_8sdp"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Back"
                app:tint="@color/back_arrow_color" />

            <!-- University Name -->
            <TextView
                android:id="@+id/universityName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/_10sdp"
                android:text="Dhaka University"
                android:textColor="@color/tittle_card"
                android:textSize="@dimen/_16ssp"
                android:textStyle="bold"
                android:fontFamily="sans-serif" />

        </LinearLayout>

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose Unit"
            android:textColor="@color/home_card_title"
            android:textSize="@dimen/_15ssp"
            android:textStyle="bold"
            android:layout_marginTop="@dimen/_14sdp"
            android:layout_marginBottom="@dimen/_16sdp" />

        <!-- Unit RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/unitRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/_20sdp"
            android:overScrollMode="never" />
    </LinearLayout>

</LinearLayout>