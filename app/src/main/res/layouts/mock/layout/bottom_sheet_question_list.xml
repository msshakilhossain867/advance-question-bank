<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/_14sdp"
    android:paddingEnd="@dimen/_14sdp"
    android:paddingTop="@dimen/_10sdp"
    android:paddingBottom="@dimen/_12sdp"
    android:background="@color/screen_background">


    <!-- Top Handle -->
    <View
        android:layout_width="@dimen/_38sdp"
        android:layout_height="@dimen/_4sdp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/_8sdp"
        android:background="@drawable/bg_bottom_sheet_handlee" />


    <!-- Title -->
    <TextView
        android:id="@+id/questionListTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="প্রশ্ন লিস্ট"
        android:textColor="@color/home_card_title"
        android:textSize="@dimen/_11ssp"
        android:textStyle="bold" />


    <!-- Legend -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_28sdp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="@dimen/_4sdp">


        <!-- Answered -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical">

            <View
                android:layout_width="@dimen/_8sdp"
                android:layout_height="@dimen/_8sdp"
                android:background="@drawable/bg_status_answered" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_4sdp"
                android:text="উত্তর দেওয়া"
                android:textColor="@color/home_card_subtitle"
                android:textSize="@dimen/_7ssp" />

        </LinearLayout>


        <!-- Skipped -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical">

            <View
                android:layout_width="@dimen/_8sdp"
                android:layout_height="@dimen/_8sdp"
                android:background="@drawable/bg_status_skipped" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_4sdp"
                android:text="রিভিউ"
                android:textColor="@color/home_card_subtitle"
                android:textSize="@dimen/_7ssp" />

        </LinearLayout>


        <!-- Unanswered -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical">

            <View
                android:layout_width="@dimen/_8sdp"
                android:layout_height="@dimen/_8sdp"
                android:background="@drawable/bg_status_unanswered" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_4sdp"
                android:text="উত্তর নেই"
                android:textColor="@color/home_card_subtitle"
                android:textSize="@dimen/_7ssp" />

        </LinearLayout>

    </LinearLayout>


    <!-- Question Grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/questionGridRecycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_3sdp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingTop="@dimen/_2sdp"
        android:paddingBottom="@dimen/_4sdp" />


    <!-- Close -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/closeQuestionListButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_32sdp"
        android:layout_marginTop="@dimen/_3sdp"
        android:text="বন্ধ করুন"
        android:textAllCaps="false"
        android:textColor="@color/home_card_title"
        android:textSize="@dimen/_8ssp"
        android:textStyle="bold"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        app:backgroundTint="@color/home_card_background"
        app:strokeColor="@color/home_card_border"
        app:strokeWidth="1dp"
        app:cornerRadius="@dimen/_7sdp" />

</LinearLayout>