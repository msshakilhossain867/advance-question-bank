<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.mocktest.MockTestReviewActivity">




    <LinearLayout


        android:layout_width="match_parent"
        android:layout_height="match_parent"

        android:orientation="vertical"
        android:background="#F8F9FC">


        <!-- Toolbar -->

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="58dp"

            android:background="#24218B"

            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@android:color/white"

            app:title="মকটেস্ট সেটআপ"
            app:titleTextColor="@android:color/white"

            app:elevation="0dp" />


        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"

            android:fillViewport="true"
            android:overScrollMode="never">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="12dp"
                android:paddingBottom="14dp">


                <!-- Test Header Card -->

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="78dp"

                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="1dp"
                    app:strokeWidth="0dp">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"

                        android:gravity="center_vertical"

                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"

                        android:orientation="horizontal">


                        <!-- University Logo -->

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="48dp"
                            android:layout_height="48dp"

                            app:cardBackgroundColor="#F4F3FF"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">


                            <ImageView
                                android:id="@+id/universityLogo"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"

                                android:padding="5dp"

                                android:src="@drawable/du_icon"

                                android:contentDescription="@null" />

                        </com.google.android.material.card.MaterialCardView>


                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"

                            android:layout_weight="1"
                            android:layout_marginStart="12dp"

                            android:orientation="vertical">


                            <TextView
                                android:id="@+id/universityName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"

                                android:text="ঢাকা বিশ্ববিদ্যালয়"

                                android:textColor="#333333"
                                android:textSize="11sp"
                                android:textStyle="bold" />


                            <TextView
                                android:id="@+id/testName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"

                                android:layout_marginTop="2dp"

                                android:text="A Unit Mock Test 01"

                                android:textColor="#171717"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- Information Card -->

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="8dp"

                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="9dp"
                    app:cardElevation="1dp"
                    app:strokeWidth="0dp">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:orientation="vertical"

                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">


                        <!-- Time -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="42dp"

                            android:gravity="center_vertical">


                            <ImageView
                                android:layout_width="17dp"
                                android:layout_height="17dp"

                                android:src="@drawable/ic_timer"
                                android:contentDescription="@null"

                                app:tint="#555555" />


                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"

                                android:layout_weight="1"
                                android:layout_marginStart="10dp"

                                android:text="মোট সময়"

                                android:textColor="#555555"
                                android:textSize="10sp" />


                            <TextView
                                android:id="@+id/testTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"

                                android:text="৬০ মিনিট"

                                android:textColor="#333333"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                        </LinearLayout>


                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#F0F0F3" />


                        <!-- Questions -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="42dp"

                            android:gravity="center_vertical">


                            <ImageView
                                android:layout_width="17dp"
                                android:layout_height="17dp"

                                android:src="@drawable/ic_list"
                                android:contentDescription="@null"

                                app:tint="#555555" />


                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"

                                android:layout_weight="1"
                                android:layout_marginStart="10dp"

                                android:text="মোট প্রশ্ন"

                                android:textColor="#555555"
                                android:textSize="10sp" />


                            <TextView
                                android:id="@+id/questionCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"

                                android:text="৬০ টি"

                                android:textColor="#333333"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                        </LinearLayout>


                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#F0F0F3" />


                        <!-- Full Marks -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="42dp"

                            android:gravity="center_vertical">


                            <ImageView
                                android:layout_width="17dp"
                                android:layout_height="17dp"

                                android:src="@drawable/ic_score"
                                android:contentDescription="@null"

                                app:tint="#555555" />


                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"

                                android:layout_weight="1"
                                android:layout_marginStart="10dp"

                                android:text="পূর্ণমান"

                                android:textColor="#555555"
                                android:textSize="10sp" />


                            <TextView
                                android:id="@+id/fullMarks"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"

                                android:text="৬০"

                                android:textColor="#333333"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                        </LinearLayout>


                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#F0F0F3" />


                        <!-- Marks -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="42dp"

                            android:gravity="center_vertical">


                            <ImageView
                                android:layout_width="17dp"
                                android:layout_height="17dp"

                                android:src="@drawable/ic_negative_marks"
                                android:contentDescription="@null"

                                app:tint="#555555" />


                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"

                                android:layout_marginStart="10dp"
                                android:layout_weight="1"

                                android:text="নেগেটিভ মার্কিং"

                                android:textColor="#555555"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/marksPerQuestion"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"

                                android:text="০.২৫"

                                android:textColor="#333333"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                        </LinearLayout>


                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#F0F0F3" />


                        <!-- Question Type -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="42dp"

                            android:gravity="center_vertical">


                            <ImageView
                                android:layout_width="17dp"
                                android:layout_height="17dp"

                                android:src="@drawable/ic_question"
                                android:contentDescription="@null"

                                app:tint="#555555" />


                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"

                                android:layout_weight="1"
                                android:layout_marginStart="10dp"

                                android:text="পরিক্ষার ধরন"

                                android:textColor="#555555"
                                android:textSize="10sp" />


                            <TextView
                                android:id="@+id/questionType"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"

                                android:text="MCQ"

                                android:textColor="#333333"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                        </LinearLayout>


                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#F0F0F3" />


                        <!-- Syllabus -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="48dp"

                            android:gravity="center_vertical">


                            <ImageView
                                android:layout_width="17dp"
                                android:layout_height="17dp"

                                android:src="@drawable/ic_book"
                                android:contentDescription="@null"

                                app:tint="#555555" />


                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"

                                android:layout_weight="1"
                                android:layout_marginStart="10dp"

                                android:text="সিলেবাস"

                                android:textColor="#555555"
                                android:textSize="10sp" />


                            <TextView
                                android:id="@+id/syllabusText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"

                                android:maxWidth="150dp"

                                android:gravity="end"

                                android:text="Question Bank"

                                android:textColor="#333333"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- Instructions -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="10dp"

                    android:orientation="vertical"

                    android:padding="12dp"

                    android:background="@drawable/bg_mock_instruction">


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="নির্দেশনা"

                        android:textColor="#4436A8"
                        android:textSize="12sp"
                        android:textStyle="bold" />


                    <TextView
                        android:id="@+id/instructionText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="7dp"

                        android:text="• সময় শেষ হলে পরীক্ষা স্বয়ংক্রিয়ভাবে জমা হবে।&#10;• প্রতিটি ভুল উত্তরের জন্য ০.২৫ নম্বর কাটা যাবে।&#10;• মকটেস্ট শুরু করার পর বন্ধ করা যাবে না।&#10;• ইন্টারনেট সংযোগ প্রয়োজন।&#10;• পরীক্ষাটি শেষে ফলাফল দেখা যাবে।"

                        android:textColor="#55516F"
                        android:textSize="10sp"

                        android:lineSpacingExtra="3dp" />

                </LinearLayout>


            </LinearLayout>

        </ScrollView>


        <!-- Start Button -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"

            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="8dp"

            android:background="@android:color/white">


            <com.google.android.material.button.MaterialButton
                android:id="@+id/startMockTestButton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:text="পরীক্ষা শুরু করুন"
                android:textAllCaps="false"

                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold"

                android:backgroundTint="#5B4DE0"

                app:cornerRadius="8dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>