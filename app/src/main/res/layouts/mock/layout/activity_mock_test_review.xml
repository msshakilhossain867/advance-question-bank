<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#24218B"
    tools:context=".presentation.mocktest.MockTestReviewActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/screen_background">

        <!-- Toolbar -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_58sdp"
            android:background="#24218B"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@android:color/white"
            app:title="মকটেস্ট সেটআপ"
            app:titleTextColor="@android:color/white"
            app:elevation="0dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/_10sdp"
                android:paddingEnd="@dimen/_10sdp"
                android:paddingTop="@dimen/_12sdp"
                android:paddingBottom="@dimen/_14sdp">

                <!-- Test Header Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_78sdp"
                    app:cardBackgroundColor="@color/home_card_background"
                    app:cardCornerRadius="@dimen/_10sdp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/home_card_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:paddingStart="@dimen/_12sdp"
                        android:paddingEnd="@dimen/_12sdp"
                        android:orientation="horizontal">

                        <!-- University Logo -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="@dimen/_48sdp"
                            android:layout_height="@dimen/_48sdp"
                            app:cardBackgroundColor="@color/screen_background"
                            app:cardCornerRadius="@dimen/_8sdp"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/home_card_border"
                            app:strokeWidth="1dp">

                            <ImageView
                                android:id="@+id/universityLogo"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="@dimen/_5sdp"
                                android:src="@drawable/du_icon"
                                android:contentDescription="@null" />

                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/_12sdp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/universityName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ঢাকা বিশ্ববিদ্যালয়"
                                android:textColor="@color/home_card_subtitle"
                                android:textSize="@dimen/_11ssp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/testName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_2sdp"
                                android:text="A Unit Mock Test 01"
                                android:textColor="@color/home_card_title"
                                android:textSize="@dimen/_13ssp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Information Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp"
                    app:cardBackgroundColor="@color/home_card_background"
                    app:cardCornerRadius="@dimen/_9sdp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/home_card_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/_12sdp"
                        android:paddingEnd="@dimen/_12sdp">

                        <!-- Time -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_42sdp"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="@dimen/_17sdp"
                                android:layout_height="@dimen/_17sdp"
                                android:src="@drawable/ic_timer"
                                android:contentDescription="@null"
                                app:tint="@color/home_card_subtitle" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="@dimen/_10sdp"
                                android:text="মোট সময়"
                                android:textColor="@color/home_card_subtitle"
                                android:textSize="@dimen/_10ssp" />

                            <TextView
                                android:id="@+id/testTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="৬০ মিনিট"
                                android:textColor="@color/home_card_title"
                                android:textSize="@dimen/_10ssp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/home_card_border" />

                        <!-- Questions -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_42sdp"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="@dimen/_17sdp"
                                android:layout_height="@dimen/_17sdp"
                                android:src="@drawable/ic_list"
                                android:contentDescription="@null"
                                app:tint="@color/home_card_subtitle" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="@dimen/_10sdp"
                                android:text="মোট প্রশ্ন"
                                android:textColor="@color/home_card_subtitle"
                                android:textSize="@dimen/_10ssp" />

                            <TextView
                                android:id="@+id/questionCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="৬০ টি"
                                android:textColor="@color/home_card_title"
                                android:textSize="@dimen/_10ssp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/home_card_border" />

                        <!-- Full Marks -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_42sdp"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="@dimen/_17sdp"
                                android:layout_height="@dimen/_17sdp"
                                android:src="@drawable/ic_score"
                                android:contentDescription="@null"
                                app:tint="@color/home_card_subtitle" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="@dimen/_10sdp"
                                android:text="পূর্ণমান"
                                android:textColor="@color/home_card_subtitle"
                                android:textSize="@dimen/_10ssp" />

                            <TextView
                                android:id="@+id/fullMarks"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="৬০"
                                android:textColor="@color/home_card_title"
                                android:textSize="@dimen/_10ssp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/home_card_border" />

                        <!-- Marks -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_42sdp"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="@dimen/_17sdp"
                                android:layout_height="@dimen/_17sdp"
                                android:src="@drawable/ic_negative_marks"
                                android:contentDescription="@null"
                                app:tint="@color/home_card_subtitle" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_10sdp"
                                android:layout_weight="1"
                                android:text="নেগেটিভ মার্কিং"
                                android:textColor="@color/home_card_subtitle"
                                android:textSize="@dimen/_10ssp" />

                            <TextView
                                android:id="@+id/marksPerQuestion"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="০.২৫"
                                android:textColor="@color/home_card_title"
                                android:textSize="@dimen/_10ssp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/home_card_border" />

                        <!-- Question Type -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_42sdp"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="@dimen/_17sdp"
                                android:layout_height="@dimen/_17sdp"
                                android:src="@drawable/ic_question"
                                android:contentDescription="@null"
                                app:tint="@color/home_card_subtitle" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="@dimen/_10sdp"
                                android:text="পরীক্ষার ধরন"
                                android:textColor="@color/home_card_subtitle"
                                android:textSize="@dimen/_10ssp" />

                            <TextView
                                android:id="@+id/questionType"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="MCQ"
                                android:textColor="@color/home_card_title"
                                android:textSize="@dimen/_10ssp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/home_card_border" />

                        <!-- Syllabus -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_48sdp"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="@dimen/_17sdp"
                                android:layout_height="@dimen/_17sdp"
                                android:src="@drawable/ic_book"
                                android:contentDescription="@null"
                                app:tint="@color/home_card_subtitle" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="@dimen/_10sdp"
                                android:text="সিলেবাস"
                                android:textColor="@color/home_card_subtitle"
                                android:textSize="@dimen/_10ssp" />

                            <TextView
                                android:id="@+id/syllabusText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxWidth="@dimen/_150sdp"
                                android:gravity="end"
                                android:text="Question Bank"
                                android:textColor="@color/home_card_title"
                                android:textSize="@dimen/_10ssp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Instructions -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:orientation="vertical"
                    android:padding="@dimen/_12sdp"
                    android:background="@drawable/bg_mock_instruction">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="নির্দেশনা"
                        android:textColor="#4436A8"
                        android:textSize="@dimen/_12ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/instructionText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_7sdp"
                        android:text="• সময় শেষ হলে পরীক্ষা স্বয়ংক্রিয়ভাবে জমা হবে।&#10;• প্রতিটি ভুল উত্তরের জন্য ০.২৫ নম্বর কাটা যাবে।&#10;• মকটেস্ট শুরু করার পর বন্ধ করা যাবে না।&#10;• ইন্টারনেট সংযোগ প্রয়োজন।&#10;• পরীক্ষাটি শেষে ফলাফল দেখা যাবে।"
                        android:textColor="#55516F"
                        android:textSize="@dimen/_10ssp"
                        android:lineSpacingExtra="@dimen/_3sdp" />

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

        <!-- Start Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_60sdp"
            android:paddingStart="@dimen/_10sdp"
            android:paddingEnd="@dimen/_10sdp"
            android:paddingTop="@dimen/_6sdp"
            android:paddingBottom="@dimen/_8sdp"
            android:background="@color/home_card_background">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/startMockTestButton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="পরীক্ষা শুরু করুন"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="@dimen/_12ssp"
                android:textStyle="bold"
                android:backgroundTint="#5B4DE0"
                app:cornerRadius="@dimen/_8sdp" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>