<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:id="@+id/main"
    android:background="@color/screen_background"
    tools:context=".presentation.mocktest.MockTestAnswerReviewActivity">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_58sdp"
        android:background="@color/home_card_background"
        app:title="উত্তর যাচাই"
        android:titleTextColor="@color/tittle_card"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/back_arrow_color" />


    <!-- Filter Tabs -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/filterTabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/home_card_background"
        android:elevation="2dp"
        app:tabGravity="fill"
        app:tabMode="fixed"
        app:tabIndicatorFullWidth="true"
        app:tabIndicatorHeight="@dimen/_3sdp"
        app:tabSelectedTextColor="#6254E8"
        app:tabTextColor="@color/home_card_subtitle" />


    <!-- Question List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/answerReviewRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="@dimen/_12sdp"
        android:scrollbars="vertical"
        android:overScrollMode="never" />

</LinearLayout>