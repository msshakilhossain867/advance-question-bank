<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.mocktest.MockTestQuestionActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#F8F9FC">

        <!-- ================= TOP BAR ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="10dp"
            android:background="@android:color/white">

            <!-- Test Name -->
            <TextView
                android:id="@+id/testName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="DU A Unit Mock Test 01"
                android:textColor="#202020"
                android:textSize="11sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Timer -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:gravity="center"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:background="@drawable/bg_timer">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_timer"
                    android:contentDescription="@null"
                    app:tint="#3530A4" />

                <TextView
                    android:id="@+id/timerText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:text="02:24:15"
                    android:textColor="#3530A4"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Space
                android:layout_width="6dp"
                android:layout_height="1dp" />

            <!-- Submit -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/submitButton"
                android:layout_width="58dp"
                android:layout_height="30dp"
                android:text="জমা দিন"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="9sp"
                android:textStyle="bold"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:backgroundTint="#5B4DE0"
                app:cornerRadius="7dp" />
        </LinearLayout>

        <!-- ================= QUESTION NUMBERS ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@android:color/white">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/questionNumberRecycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:nestedScrollingEnabled="false"
                android:paddingStart="4dp"
                android:paddingEnd="4dp" />
        </LinearLayout>

        <!-- ================= SECTION TITLE ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="#FFFFFF">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="প্রশ্নের বিবরণ"
                android:textColor="#27235E"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ================= MAIN CONTENT ================= -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="12dp">

                <!-- Question Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="9dp"
                    app:cardElevation="1dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <!-- Question Frame (TextView & WebView উভয়ই থাকবে) -->
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:id="@+id/questionText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="৩. আলোর বেগ শূন্য মাধ্যমে কত?"
                                android:textColor="#222222"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:lineSpacingExtra="2dp" />

                            <WebView
                                android:id="@+id/questionWebView"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:visibility="gone" />
                        </FrameLayout>

                        <!-- Option A -->
                        <LinearLayout
                            android:id="@+id/optionA"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="39dp"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:background="@drawable/bg_mock_option">

                            <TextView
                                android:id="@+id/optionALabel"
                                android:layout_width="25dp"
                                android:layout_height="25dp"
                                android:gravity="center"
                                android:text="A"
                                android:textColor="#687080"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:background="@drawable/bg_mock_option_letter" />

                            <FrameLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp">

                                <TextView
                                    android:id="@+id/optionAText"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="3×10⁸ m/s"
                                    android:textColor="#333333"
                                    android:textSize="10sp" />

                                <WebView
                                    android:id="@+id/optionAWebView"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:visibility="gone" />
                            </FrameLayout>

                            <ImageView
                                android:id="@+id/optionACheck"
                                android:layout_width="17dp"
                                android:layout_height="17dp"
                                android:visibility="gone"
                                android:src="@drawable/ic_check_circle"
                                android:contentDescription="@null" />
                        </LinearLayout>

                        <!-- Option B -->
                        <LinearLayout
                            android:id="@+id/optionB"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="39dp"
                            android:layout_marginTop="6dp"
                            android:gravity="center_vertical"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:background="@drawable/bg_mock_option">

                            <TextView
                                android:id="@+id/optionBLabel"
                                android:layout_width="25dp"
                                android:layout_height="25dp"
                                android:gravity="center"
                                android:text="B"
                                android:textColor="#687080"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:background="@drawable/bg_mock_option_letter" />

                            <FrameLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp">

                                <TextView
                                    android:id="@+id/optionBText"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="3×10⁶ m/s"
                                    android:textColor="#333333"
                                    android:textSize="10sp" />

                                <WebView
                                    android:id="@+id/optionBWebView"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:visibility="gone" />
                            </FrameLayout>

                            <ImageView
                                android:id="@+id/optionBCheck"
                                android:layout_width="17dp"
                                android:layout_height="17dp"
                                android:visibility="gone"
                                android:src="@drawable/ic_check_circle"
                                android:contentDescription="@null" />
                        </LinearLayout>

                        <!-- Option C -->
                        <LinearLayout
                            android:id="@+id/optionC"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="39dp"
                            android:layout_marginTop="6dp"
                            android:gravity="center_vertical"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:background="@drawable/bg_mock_option_selected">

                            <TextView
                                android:id="@+id/optionCLabel"
                                android:layout_width="25dp"
                                android:layout_height="25dp"
                                android:gravity="center"
                                android:text="C"
                                android:textColor="@android:color/white"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:background="@drawable/bg_mock_option_letter_selected" />

                            <FrameLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp">

                                <TextView
                                    android:id="@+id/optionCText"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="3×10¹⁰ m/s"
                                    android:textColor="#333333"
                                    android:textSize="10sp"
                                    android:textStyle="bold" />

                                <WebView
                                    android:id="@+id/optionCWebView"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:visibility="gone" />
                            </FrameLayout>

                            <ImageView
                                android:id="@+id/optionCCheck"
                                android:layout_width="17dp"
                                android:layout_height="17dp"
                                android:src="@drawable/ic_check_circle"
                                android:contentDescription="@null" />
                        </LinearLayout>

                        <!-- Option D -->
                        <LinearLayout
                            android:id="@+id/optionD"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="39dp"
                            android:layout_marginTop="6dp"
                            android:gravity="center_vertical"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:background="@drawable/bg_mock_option">

                            <TextView
                                android:id="@+id/optionDLabel"
                                android:layout_width="25dp"
                                android:layout_height="25dp"
                                android:gravity="center"
                                android:text="D"
                                android:textColor="#687080"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:background="@drawable/bg_mock_option_letter" />

                            <FrameLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp">

                                <TextView
                                    android:id="@+id/optionDText"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="3×10⁷ m/s"
                                    android:textColor="#333333"
                                    android:textSize="10sp" />

                                <WebView
                                    android:id="@+id/optionDWebView"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:visibility="gone" />
                            </FrameLayout>

                            <ImageView
                                android:id="@+id/optionDCheck"
                                android:layout_width="17dp"
                                android:layout_height="17dp"
                                android:visibility="gone"
                                android:src="@drawable/ic_check_circle"
                                android:contentDescription="@null" />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </ScrollView>

        <!-- ================= BOTTOM NAVIGATION ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="3dp"
            android:background="@android:color/white">

            <!-- Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <!-- Previous -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/previousButton"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:text="‹ আগের প্রশ্ন"
                    android:textAllCaps="false"
                    android:textColor="#5548D2"
                    android:textSize="8sp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:backgroundTint="@android:color/white"
                    app:cornerRadius="7dp"
                    app:strokeColor="#C9C4F5"
                    app:strokeWidth="1dp" />

                <Space
                    android:layout_width="5dp"
                    android:layout_height="1dp" />

                <!-- Question List -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/questionListButton"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:text="☷ প্রশ্নের লিস্ট"
                    android:textAllCaps="false"
                    android:textColor="#5548D2"
                    android:textSize="8sp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:backgroundTint="@android:color/white"
                    app:cornerRadius="7dp"
                    app:strokeColor="#C9C4F5"
                    app:strokeWidth="1dp" />

                <Space
                    android:layout_width="5dp"
                    android:layout_height="1dp" />

                <!-- Review -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/reviewButton"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:text="⚑ রিভিউ"
                    android:textAllCaps="false"
                    android:textColor="#5548D2"
                    android:textSize="8sp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:backgroundTint="@android:color/white"
                    app:cornerRadius="7dp"
                    app:strokeColor="#C9C4F5"
                    app:strokeWidth="1dp" />

                <Space
                    android:layout_width="5dp"
                    android:layout_height="1dp" />

                <!-- Skip / Next -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/skipNextButton"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:text="Skip ›"
                    android:textAllCaps="false"
                    android:textColor="#5548D2"
                    android:textSize="8sp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:backgroundTint="#F0EEFF"
                    app:cornerRadius="7dp" />
            </LinearLayout>

            <!-- Status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:gravity="center_vertical">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_status_answered" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="উত্তর দেওয়া"
                    android:textColor="#666666"
                    android:textSize="7sp" />

                <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_status_skipped" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="রিভিউ"
                    android:textColor="#666666"
                    android:textSize="7sp" />

                <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_status_unanswered" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="উত্তর নেই"
                    android:textColor="#666666"
                    android:textSize="7sp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>