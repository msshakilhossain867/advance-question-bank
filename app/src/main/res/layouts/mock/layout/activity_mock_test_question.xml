<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.mocktest.MockTestQuestionActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/screen_background">

        <!-- ================= TOP BAR ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_58sdp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/_12sdp"
            android:paddingEnd="@dimen/_10sdp"
            android:background="@color/home_card_background">

            <!-- Test Name -->
            <TextView
                android:id="@+id/testName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="DU A Unit Mock Test 01"
                android:textColor="@color/home_card_title"
                android:textSize="@dimen/_11ssp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Timer -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_30sdp"
                android:gravity="center"
                android:paddingStart="@dimen/_7sdp"
                android:paddingEnd="@dimen/_7sdp"
                android:background="@drawable/bg_timer">

                <ImageView
                    android:layout_width="@dimen/_14sdp"
                    android:layout_height="@dimen/_14sdp"
                    android:src="@drawable/ic_timer"
                    android:contentDescription="@null"
                    app:tint="#3530A4" />

                <TextView
                    android:id="@+id/timerText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_3sdp"
                    android:text="02:24:15"
                    android:textColor="#3530A4"
                    android:textSize="@dimen/_9ssp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Space
                android:layout_width="@dimen/_6sdp"
                android:layout_height="1dp" />

            <!-- Submit -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/submitButton"
                android:layout_width="@dimen/_58sdp"
                android:layout_height="@dimen/_30sdp"
                android:text="জমা দিন"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="@dimen/_9ssp"
                android:textStyle="bold"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:backgroundTint="#5B4DE0"
                app:cornerRadius="@dimen/_7sdp" />
        </LinearLayout>

        <!-- ================= QUESTION NUMBERS ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_44sdp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/_12sdp"
            android:paddingEnd="@dimen/_12sdp"
            android:background="@color/home_card_background">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/questionNumberRecycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_marginEnd="@dimen/_8sdp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:nestedScrollingEnabled="false"
                android:paddingStart="@dimen/_4sdp"
                android:paddingEnd="@dimen/_4sdp" />
        </LinearLayout>

        <!-- ================= SECTION TITLE ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_36sdp"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/_14sdp"
            android:paddingEnd="@dimen/_14sdp"
            android:background="@color/home_card_background">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="প্রশ্নের বিবরণ"
                android:textColor="@color/home_card_title"
                android:textSize="@dimen/_11ssp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ================= MAIN CONTENT ================= -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/_14sdp"
                android:paddingEnd="@dimen/_14sdp"
                android:paddingTop="@dimen/_8sdp"
                android:paddingBottom="@dimen/_12sdp">

                <!-- Question Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/home_card_background"
                    app:cardCornerRadius="@dimen/_9sdp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/home_card_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/_10sdp">

                        <!-- Question Frame -->
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:id="@+id/questionText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="৩. আলোর বেগ শূন্য মাধ্যমে কত?"
                                android:textColor="@color/home_card_title"
                                android:textSize="@dimen/_12ssp"
                                android:textStyle="bold"
                                android:lineSpacingExtra="@dimen/_2sdp" />

                            <WebView
                                android:id="@+id/questionWebView"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:visibility="gone"
                                tools:ignore="WebViewLayout" />
                        </FrameLayout>

                        <!-- Option A -->
                        <LinearLayout
                            android:id="@+id/optionA"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/_39sdp"
                            android:layout_marginTop="@dimen/_10sdp"
                            android:gravity="center_vertical"
                            android:paddingStart="@dimen/_8sdp"
                            android:paddingEnd="@dimen/_8sdp"
                            android:background="@drawable/bg_mock_option">

                            <TextView
                                android:id="@+id/optionALabel"
                                android:layout_width="@dimen/_25sdp"
                                android:layout_height="@dimen/_25sdp"
                                android:gravity="center"
                                android:text="A"
                                android:textColor="#687080"
                                android:textSize="@dimen/_9ssp"
                                android:textStyle="bold"
                                android:background="@drawable/bg_mock_option_letter" />

                            <FrameLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="@dimen/_8sdp">

                                <TextView
                                    android:id="@+id/optionAText"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="3×10⁸ m/s"
                                    android:textColor="@color/home_card_title"
                                    android:textSize="@dimen/_10ssp" />

                                <WebView
                                    android:id="@+id/optionAWebView"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:visibility="gone" />
                            </FrameLayout>

                            <ImageView
                                android:id="@+id/optionACheck"
                                android:layout_width="@dimen/_17sdp"
                                android:layout_height="@dimen/_17sdp"
                                android:visibility="gone"
                                android:src="@drawable/ic_check_circle"
                                android:contentDescription="@null" />
                        </LinearLayout>

                        <!-- Option B -->
                        <LinearLayout
                            android:id="@+id/optionB"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/_39sdp"
                            android:layout_marginTop="@dimen/_6sdp"
                            android:gravity="center_vertical"
                            android:paddingStart="@dimen/_8sdp"
                            android:paddingEnd="@dimen/_8sdp"
                            android:background="@drawable/bg_mock_option">

                            <TextView
                                android:id="@+id/optionBLabel"
                                android:layout_width="@dimen/_25sdp"
                                android:layout_height="@dimen/_25sdp"
                                android:gravity="center"
                                android:text="B"
                                android:textColor="#687080"
                                android:textSize="@dimen/_9ssp"
                                android:textStyle="bold"
                                android:background="@drawable/bg_mock_option_letter" />

                            <FrameLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="@dimen/_8sdp">

                                <TextView
                                    android:id="@+id/optionBText"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="3×10⁶ m/s"
                                    android:textColor="@color/home_card_title"
                                    android:textSize="@dimen/_10ssp" />

                                <WebView
                                    android:id="@+id/optionBWebView"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:visibility="gone" />
                            </FrameLayout>

                            <ImageView
                                android:id="@+id/optionBCheck"
                                android:layout_width="@dimen/_17sdp"
                                android:layout_height="@dimen/_17sdp"
                                android:visibility="gone"
                                android:src="@drawable/ic_check_circle"
                                android:contentDescription="@null" />
                        </LinearLayout>

                        <!-- Option C -->
                        <LinearLayout
                            android:id="@+id/optionC"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/_39sdp"
                            android:layout_marginTop="@dimen/_6sdp"
                            android:gravity="center_vertical"
                            android:paddingStart="@dimen/_8sdp"
                            android:paddingEnd="@dimen/_8sdp"
                            android:background="@drawable/bg_mock_option_selected">

                            <TextView
                                android:id="@+id/optionCLabel"
                                android:layout_width="@dimen/_25sdp"
                                android:layout_height="@dimen/_25sdp"
                                android:gravity="center"
                                android:text="C"
                                android:textColor="@android:color/white"
                                android:textSize="@dimen/_9ssp"
                                android:textStyle="bold"
                                android:background="@drawable/bg_mock_option_letter_selected" />

                            <FrameLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="@dimen/_8sdp">

                                <TextView
                                    android:id="@+id/optionCText"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="3×10¹⁰ m/s"
                                    android:textColor="@color/home_card_title"
                                    android:textSize="@dimen/_10ssp"
                                    android:textStyle="bold" />

                                <WebView
                                    android:id="@+id/optionCWebView"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:visibility="gone" />
                            </FrameLayout>

                            <ImageView
                                android:id="@+id/optionCCheck"
                                android:layout_width="@dimen/_17sdp"
                                android:layout_height="@dimen/_17sdp"
                                android:src="@drawable/ic_check_circle"
                                android:contentDescription="@null" />
                        </LinearLayout>

                        <!-- Option D -->
                        <LinearLayout
                            android:id="@+id/optionD"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/_39sdp"
                            android:layout_marginTop="@dimen/_6sdp"
                            android:gravity="center_vertical"
                            android:paddingStart="@dimen/_8sdp"
                            android:paddingEnd="@dimen/_8sdp"
                            android:background="@drawable/bg_mock_option">

                            <TextView
                                android:id="@+id/optionDLabel"
                                android:layout_width="@dimen/_25sdp"
                                android:layout_height="@dimen/_25sdp"
                                android:gravity="center"
                                android:text="D"
                                android:textColor="#687080"
                                android:textSize="@dimen/_9ssp"
                                android:textStyle="bold"
                                android:background="@drawable/bg_mock_option_letter" />

                            <FrameLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="@dimen/_8sdp"
                                tools:ignore="WebViewLayout">

                                <TextView
                                    android:id="@+id/optionDText"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="3×10⁷ m/s"
                                    android:textColor="@color/home_card_title"
                                    android:textSize="@dimen/_10ssp" />

                                <WebView
                                    android:id="@+id/optionDWebView"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:visibility="gone" />
                            </FrameLayout>

                            <ImageView
                                android:id="@+id/optionDCheck"
                                android:layout_width="@dimen/_17sdp"
                                android:layout_height="@dimen/_17sdp"
                                android:visibility="gone"
                                android:src="@drawable/ic_check_circle"
                                android:contentDescription="@null" />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </ScrollView>

        <!-- ================= BOTTOM NAVIGATION ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_72sdp"
            android:orientation="vertical"
            android:paddingStart="@dimen/_10sdp"
            android:paddingEnd="@dimen/_10sdp"
            android:paddingTop="@dimen/_5sdp"
            android:paddingBottom="@dimen/_3sdp"
            android:background="@color/home_card_background">

            <!-- Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_40sdp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/_8sdp"
                android:paddingEnd="@dimen/_8sdp">

                <!-- Previous -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/previousButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_34sdp"
                    android:layout_weight="1"
                    android:text="‹ আগের প্রশ্ন"
                    android:textAllCaps="false"
                    android:textColor="#5548D2"
                    android:textSize="@dimen/_8ssp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:backgroundTint="@color/home_card_background"
                    app:cornerRadius="@dimen/_7sdp"
                    app:strokeColor="@color/home_card_border"
                    app:strokeWidth="1dp" />

                <Space
                    android:layout_width="@dimen/_5sdp"
                    android:layout_height="1dp" />

                <!-- Question List -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/questionListButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_34sdp"
                    android:layout_weight="1"
                    android:text="☷ প্রশ্নের লিস্ট"
                    android:textAllCaps="false"
                    android:textColor="#5548D2"
                    android:textSize="@dimen/_8ssp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:backgroundTint="@color/home_card_background"
                    app:cornerRadius="@dimen/_7sdp"
                    app:strokeColor="@color/home_card_border"
                    app:strokeWidth="1dp" />

                <Space
                    android:layout_width="@dimen/_5sdp"
                    android:layout_height="1dp" />

                <!-- Review -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/reviewButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_34sdp"
                    android:layout_weight="1"
                    android:text="⚑ রিভিউ"
                    android:textAllCaps="false"
                    android:textColor="#5548D2"
                    android:textSize="@dimen/_8ssp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:backgroundTint="@color/home_card_background"
                    app:cornerRadius="@dimen/_7sdp"
                    app:strokeColor="@color/home_card_border"
                    app:strokeWidth="1dp" />

                <Space
                    android:layout_width="@dimen/_5sdp"
                    android:layout_height="1dp" />

                <!-- Skip / Next -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/skipNextButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_34sdp"
                    android:layout_weight="1"
                    android:text="Skip ›"
                    android:textAllCaps="false"
                    android:textColor="#5548D2"
                    android:textSize="@dimen/_8ssp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:backgroundTint="@color/home_card_background"
                    app:strokeColor="@color/home_card_border"
                    app:strokeWidth="1dp"
                    app:cornerRadius="@dimen/_7sdp" />
            </LinearLayout>

            <!-- Status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_28sdp"
                android:gravity="center_vertical">

                <View
                    android:layout_width="@dimen/_8sdp"
                    android:layout_height="@dimen/_8sdp"
                    android:background="@drawable/bg_status_answered" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:text="উত্তর দেওয়া"
                    android:textColor="@color/home_card_subtitle"
                    android:textSize="@dimen/_7ssp" />

                <Space
                    android:layout_width="@dimen/_12sdp"
                    android:layout_height="1dp" />

                <View
                    android:layout_width="@dimen/_8sdp"
                    android:layout_height="@dimen/_8sdp"
                    android:background="@drawable/bg_status_skipped" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:text="রিভিউ"
                    android:textColor="@color/home_card_subtitle"
                    android:textSize="@dimen/_7ssp" />

                <Space
                    android:layout_width="@dimen/_12sdp"
                    android:layout_height="1dp" />

                <View
                    android:layout_width="@dimen/_8sdp"
                    android:layout_height="@dimen/_8sdp"
                    android:background="@drawable/bg_status_unanswered" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:text="উত্তর নেই"
                    android:textColor="@color/home_card_subtitle"
                    android:textSize="@dimen/_7ssp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>