<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#28218F"
    tools:context=".presentation.mocktest.MockTestResultActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/screen_background">

        <!-- ================= TOOLBAR ================= -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_52sdp"
            android:background="#28218F"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@android:color/white"
            app:title="পরীক্ষার রেজাল্ট"
            app:titleTextColor="@android:color/white"
            app:menu="@menu/result_menu"
            app:elevation="0dp" />

        <!-- ================= CONTENT ================= -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/rootLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingStart="@dimen/_14sdp"
                android:paddingEnd="@dimen/_14sdp"
                android:paddingTop="@dimen/_14sdp"
                android:paddingBottom="@dimen/_18sdp">

                <!-- ================= TROPHY ================= -->
                <ImageView
                    android:id="@+id/resultTrophy"
                    android:layout_width="@dimen/_68sdp"
                    android:layout_height="@dimen/_68sdp"
                    android:src="@drawable/ic_trophy_result"
                    android:contentDescription="@null" />

                <!-- Congratulations -->
                <TextView
                    android:id="@+id/congratulationText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:text="অভিনন্দন! 🎉"
                    android:textColor="@color/home_card_title"
                    android:textSize="@dimen/_15ssp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/resultMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:text="আপনি পরীক্ষা সম্পন্ন করেছেন।"
                    android:textColor="@color/home_card_subtitle"
                    android:textSize="@dimen/_9ssp" />

                <!-- ================= SCORE RING ================= -->
                <FrameLayout
                    android:layout_width="@dimen/_126sdp"
                    android:layout_height="@dimen/_126sdp"
                    android:layout_marginTop="@dimen/_10sdp">

                    <!-- Ring -->
                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/scoreProgress"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:indeterminate="false"
                        app:indicatorSize="@dimen/_116sdp"
                        app:trackThickness="@dimen/_5sdp"
                        app:trackColor="@color/home_card_border"
                        app:indicatorColor="#4F3FD0" />

                    <!-- Score Text -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="প্রাপ্ত নম্বর"
                            android:textColor="@color/home_card_subtitle"
                            android:textSize="@dimen/_8ssp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/scoreText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="78.50"
                                android:textColor="@color/home_card_title"
                                android:textSize="@dimen/_21ssp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/scoreTotalText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_3sdp"
                                android:text="/100"
                                android:textColor="@color/home_card_subtitle"
                                android:textSize="@dimen/_9ssp" />

                        </LinearLayout>

                    </LinearLayout>

                </FrameLayout>

                <!-- ================= STATISTICS ================= -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_70sdp"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <!-- Correct -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="সঠিক উত্তর"
                            android:textColor="@color/home_card_subtitle"
                            android:textSize="@dimen/_8ssp" />

                        <TextView
                            android:id="@+id/correctText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_4sdp"
                            android:text="86"
                            android:textColor="#20A66A"
                            android:textSize="@dimen/_13ssp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Wrong -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ভুল উত্তর"
                            android:textColor="@color/home_card_subtitle"
                            android:textSize="@dimen/_8ssp" />

                        <TextView
                            android:id="@+id/wrongText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_4sdp"
                            android:text="12"
                            android:textColor="#F05A5A"
                            android:textSize="@dimen/_13ssp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Negative -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="নেগেটিভ মার্ক"
                            android:textColor="@color/home_card_subtitle"
                            android:textSize="@dimen/_8ssp" />

                        <TextView
                            android:id="@+id/negativeMarkText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_4sdp"
                            android:text="-3.00"
                            android:textColor="#F05A5A"
                            android:textSize="@dimen/_13ssp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Total -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="মোট প্রশ্ন"
                            android:textColor="@color/home_card_subtitle"
                            android:textSize="@dimen/_8ssp" />

                        <TextView
                            android:id="@+id/totalQuestionText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_4sdp"
                            android:text="98/100"
                            android:textColor="@color/home_card_title"
                            android:textSize="@dimen/_13ssp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

                <!-- ================= BUTTONS ================= -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_42sdp"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:orientation="horizontal">

                    <!-- Home -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/homeButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_38sdp"
                        android:layout_weight="1"
                        android:text="⌂  হোমে ফিরুন"
                        android:textAllCaps="false"
                        android:textColor="#5144D0"
                        android:textSize="@dimen/_8ssp"
                        android:textStyle="bold"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:backgroundTint="@color/home_card_background"
                        app:strokeColor="@color/home_card_border"
                        app:strokeWidth="1dp"
                        app:cornerRadius="@dimen/_7sdp" />

                    <Space
                        android:layout_width="@dimen/_6sdp"
                        android:layout_height="1dp" />

                    <!-- Check Answers -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/checkAnswersButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_38sdp"
                        android:layout_weight="1"
                        android:text="✓  উত্তর যাচাই করুন"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/_8ssp"
                        android:textStyle="bold"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:backgroundTint="#5B4DE0"
                        app:cornerRadius="@dimen/_7sdp" />

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>