<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/yearCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_10sdp"
    app:cardBackgroundColor="@color/home_card_background"
    app:cardCornerRadius="@dimen/_9sdp"
    app:cardElevation="3dp"
    app:strokeColor="@color/home_card_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_112sdp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="@dimen/_8sdp">

        <!-- Year Icon -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/iconCard"
            android:layout_width="@dimen/_38sdp"
            android:layout_height="@dimen/_38sdp"
            app:cardCornerRadius="@dimen/_7sdp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="#1976D2">

            <ImageView
                android:id="@+id/yearIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="@dimen/_9sdp"
                android:src="@drawable/ic_booky"
                android:contentDescription="@null"
                app:tint="@android:color/white" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Academic Year -->
        <TextView
            android:id="@+id/yearText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2024-25"
            android:textColor="@color/home_card_title"
            android:textSize="@dimen/_13ssp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="@dimen/_8sdp" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/yearSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Start Learning"
            android:textColor="@color/home_card_subtitle"
            android:textSize="@dimen/_9ssp"
            android:gravity="center"
            android:layout_marginTop="@dimen/_2sdp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>