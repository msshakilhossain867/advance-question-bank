<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/_7sdp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/subjectName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Physics"
            android:textColor="@color/home_card_title"
            android:textSize="@dimen/_12ssp" />

        <TextView
            android:id="@+id/subjectScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="8 / 10"
            android:textColor="@color/home_card_subtitle"
            android:textSize="@dimen/_11ssp" />

    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_5sdp"
        android:gravity="center_vertical">

        <ProgressBar
            android:id="@+id/subjectProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="@dimen/_6sdp"
            android:layout_weight="1"
            android:max="100"
            android:progress="80"
            android:progressDrawable="@drawable/bg_subject_progress" />

        <TextView
            android:id="@+id/subjectPercent"
            android:layout_width="@dimen/_35sdp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="80%"
            android:textColor="@color/home_card_subtitle"
            android:textSize="@dimen/_10ssp" />

    </LinearLayout>

</LinearLayout>