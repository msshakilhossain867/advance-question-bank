<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:orientation="vertical"

    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="20dp"

    android:background="@android:color/white">


    <!-- Drag Handle -->

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"

        android:layout_marginBottom="16dp"

        android:background="@drawable/bg_bottom_sheet_handlee" />


    <!-- Title -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:text="Report Question"

        android:textColor="#202020"
        android:textSize="17sp"
        android:textStyle="bold" />


    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginTop="3dp"
        android:layout_marginBottom="12dp"

        android:text="What is wrong with this question?"

        android:textColor="#777777"
        android:textSize="11sp" />


    <!-- Reasons -->

    <RadioGroup
        android:id="@+id/reportReasonGroup"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical">


        <RadioButton
            android:id="@+id/reasonWrongAnswer"

            android:layout_width="match_parent"
            android:layout_height="42dp"

            android:text="উত্তর ভুল"
            android:textColor="#333333"
            android:textSize="12sp" />


        <RadioButton
            android:id="@+id/reasonWrongExplanation"

            android:layout_width="match_parent"
            android:layout_height="42dp"

            android:text="ব্যাখ্যা ভুল"
            android:textColor="#333333"
            android:textSize="12sp" />


        <RadioButton
            android:id="@+id/reasonWrongSpelling"

            android:layout_width="match_parent"
            android:layout_height="42dp"

            android:text="বানান ভুল"
            android:textColor="#333333"
            android:textSize="12sp" />


        <RadioButton
            android:id="@+id/reasonWrongQuestion"

            android:layout_width="match_parent"
            android:layout_height="42dp"

            android:text="প্রশ্ন ভুল"
            android:textColor="#333333"
            android:textSize="12sp" />


        <RadioButton
            android:id="@+id/reasonOther"

            android:layout_width="match_parent"
            android:layout_height="42dp"

            android:text="অন্যান্য ভুল"
            android:textColor="#333333"
            android:textSize="12sp" />

    </RadioGroup>


    <!-- Comment -->

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginTop="8dp"

        android:hint="আপনার মন্তব্য লিখুন (Optional)"

        app:boxBackgroundMode="outline"
        app:boxCornerRadiusTopStart="10dp"
        app:boxCornerRadiusTopEnd="10dp"
        app:boxCornerRadiusBottomStart="10dp"
        app:boxCornerRadiusBottomEnd="10dp">


        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/reportComment"

            android:layout_width="match_parent"
            android:layout_height="90dp"

            android:gravity="top"

            android:inputType="textMultiLine"

            android:textSize="12sp" />

    </com.google.android.material.textfield.TextInputLayout>


    <!-- Buttons -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"

        android:layout_marginTop="14dp"

        android:orientation="horizontal">


        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancelReportButton"

            android:layout_width="0dp"
            android:layout_height="match_parent"

            android:layout_weight="1"

            android:text="Cancel"
            android:textAllCaps="false"

            android:textColor="#555555"
            android:textSize="12sp"

            app:backgroundTint="#F1F1F5"
            app:cornerRadius="9dp" />


        <Space
            android:layout_width="8dp"
            android:layout_height="1dp" />


        <com.google.android.material.button.MaterialButton
            android:id="@+id/submitReportButton"

            android:layout_width="0dp"
            android:layout_height="match_parent"

            android:layout_weight="1"

            android:text="Send Report"
            android:textAllCaps="false"

            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold"

            app:backgroundTint="#5B4DE0"
            app:cornerRadius="9dp" />

    </LinearLayout>

</LinearLayout>