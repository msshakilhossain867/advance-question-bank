<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/_20sdp"
    android:paddingEnd="@dimen/_20sdp"
    android:paddingTop="@dimen/_12sdp"
    android:paddingBottom="@dimen/_20sdp"
    android:background="@color/home_card_background">


    <!-- Drag Handle -->
    <View
        android:layout_width="@dimen/_40sdp"
        android:layout_height="@dimen/_4sdp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/_16sdp"
        android:background="@drawable/bg_bottom_sheet_handlee" />


    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Report Question"
        android:textColor="@color/home_card_title"
        android:textSize="@dimen/_17ssp"
        android:textStyle="bold" />


    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_3sdp"
        android:layout_marginBottom="@dimen/_12sdp"
        android:text="What is wrong with this question?"
        android:textColor="@color/home_card_subtitle"
        android:textSize="@dimen/_11ssp" />


    <!-- Reasons -->
    <RadioGroup
        android:id="@+id/reportReasonGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">


        <RadioButton
            android:id="@+id/reasonWrongAnswer"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_42sdp"
            android:text="উত্তর ভুল"
            android:textColor="@color/home_card_title"
            android:textSize="@dimen/_12ssp" />


        <RadioButton
            android:id="@+id/reasonWrongExplanation"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_42sdp"
            android:text="ব্যাখ্যা ভুল"
            android:textColor="@color/home_card_title"
            android:textSize="@dimen/_12ssp" />


        <RadioButton
            android:id="@+id/reasonWrongSpelling"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_42sdp"
            android:text="বানান ভুল"
            android:textColor="@color/home_card_title"
            android:textSize="@dimen/_12ssp" />


        <RadioButton
            android:id="@+id/reasonWrongQuestion"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_42sdp"
            android:text="প্রশ্ন ভুল"
            android:textColor="@color/home_card_title"
            android:textSize="@dimen/_12ssp" />


        <RadioButton
            android:id="@+id/reasonOther"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_42sdp"
            android:text="অন্যান্য ভুল"
            android:textColor="@color/home_card_title"
            android:textSize="@dimen/_12ssp" />

    </RadioGroup>


    <!-- Comment -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8sdp"
        android:hint="আপনার মন্তব্য লিখুন (Optional)"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusTopStart="@dimen/_10sdp"
        app:boxCornerRadiusTopEnd="@dimen/_10sdp"
        app:boxCornerRadiusBottomStart="@dimen/_10sdp"
        app:boxCornerRadiusBottomEnd="@dimen/_10sdp"
        app:boxStrokeColor="@color/home_card_border"
        app:hintTextColor="@color/home_card_subtitle">


        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/reportComment"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_90sdp"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:textColor="@color/home_card_title"
            android:textSize="@dimen/_12ssp" />

    </com.google.android.material.textfield.TextInputLayout>


    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_48sdp"
        android:layout_marginTop="@dimen/_14sdp"
        android:orientation="horizontal">


        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancelReportButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="@color/home_card_title"
            android:textSize="@dimen/_12ssp"
            app:backgroundTint="@color/screen_background"
            app:strokeColor="@color/home_card_border"
            app:strokeWidth="1dp"
            app:cornerRadius="@dimen/_9sdp" />


        <Space
            android:layout_width="@dimen/_8sdp"
            android:layout_height="1dp" />


        <com.google.android.material.button.MaterialButton
            android:id="@+id/submitReportButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Send Report"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="@dimen/_12ssp"
            android:textStyle="bold"
            app:backgroundTint="#5B4DE0"
            app:cornerRadius="@dimen/_9sdp" />

    </LinearLayout>

</LinearLayout>