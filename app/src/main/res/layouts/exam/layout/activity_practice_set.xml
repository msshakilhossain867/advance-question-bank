<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.exam.PracticeSetActivity">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#F8F9FC">

        <!-- Toolbar -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="#5B4DE0"
            app:title="Practice MCQ"
            app:titleTextColor="@android:color/white"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@android:color/white"
            app:elevation="0dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="20dp">

                <!-- Advanced Filter Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_filter_list"
                        app:tint="#222222"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Advanced Filter"
                        android:textColor="#202020"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Customize your practice"
                    android:textColor="#777777"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />


                <!-- Select Subjects -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="22dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Select Subjects"
                        android:textColor="#202020"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="(Multiple Select)"
                        android:textColor="#777777"
                        android:textSize="10sp" />

                </LinearLayout>


                <!-- Subject RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/subjectRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginTop="8dp"
                    android:clipToPadding="false"
                    android:overScrollMode="never" />


                <!-- Number of Questions -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Number of Questions"
                    android:textColor="#202020"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="10dp" />


                <LinearLayout
                    android:id="@+id/questionCountContainer"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/countAll"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"

                        android:text="ALL"
                        android:textColor="#333333"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"

                        app:backgroundTint="#FFFFFF"
                        app:strokeColor="#D9DCE3"
                        app:strokeWidth="1dp"
                        app:cornerRadius="8dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/count10"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"

                        android:text="10"
                        android:textColor="#333333"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"

                        app:backgroundTint="#FFFFFF"
                        app:strokeColor="#D9DCE3"
                        app:strokeWidth="1dp"
                        app:cornerRadius="8dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/count20"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"

                        android:text="20"
                        android:textColor="#333333"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"

                        app:backgroundTint="#FFFFFF"
                        app:strokeColor="#D9DCE3"
                        app:strokeWidth="1dp"
                        app:cornerRadius="8dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/count30"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"

                        android:text="30"
                        android:textColor="#333333"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"

                        app:backgroundTint="#FFFFFF"
                        app:strokeColor="#D9DCE3"
                        app:strokeWidth="1dp"
                        app:cornerRadius="8dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/count40"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"

                        android:text="40"
                        android:textColor="#333333"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"

                        app:backgroundTint="#FFFFFF"
                        app:strokeColor="#D9DCE3"
                        app:strokeWidth="1dp"
                        app:cornerRadius="8dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/count50"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"

                        android:text="50"
                        android:textColor="#333333"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"

                        app:backgroundTint="#FFFFFF"
                        app:strokeColor="#D9DCE3"
                        app:strokeWidth="1dp"
                        app:cornerRadius="8dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/count60"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"

                        android:text="60"
                        android:textColor="#333333"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"

                        app:backgroundTint="#FFFFFF"
                        app:strokeColor="#D9DCE3"
                        app:strokeWidth="1dp"
                        app:cornerRadius="8dp"/>

                </LinearLayout>


                <!-- Chapter -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chapter (Optional)"
                    android:textColor="#202020"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp" />



                <!-- Time Per Question -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Time per Question"
                            android:textColor="#202020"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="(Optional)"
                            android:textColor="#888888"
                            android:textSize="9sp" />

                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/timeSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:thumbTint="@color/white"
                        app:trackTint="@color/switch_track_selector" />

                </LinearLayout>


                <!-- Show Explanation -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Show Explanation"
                            android:textColor="#202020"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="(After Answer)"
                            android:textColor="#888888"
                            android:textSize="9sp" />

                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/explanationSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        app:thumbTint="@color/white"
                        app:trackTint="@color/switch_track_selector" />

                </LinearLayout>


                <!-- Start Practice -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/startPracticeButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:text="Confirm"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:backgroundTint="#5B4DE0"
                    app:cornerRadius="9dp" />

            </LinearLayout>

        </ScrollView>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>