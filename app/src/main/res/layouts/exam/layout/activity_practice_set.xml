<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    tools:context=".presentation.exam.PracticeSetActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        >

        <!-- Toolbar -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_58sdp"
            app:title="Practice MCQ"
            app:titleTextColor="@color/tittle_card"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/back_arrow_color"
            app:elevation="0dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/_16sdp"
                android:paddingEnd="@dimen/_16sdp"
                android:paddingTop="@dimen/_14sdp"
                android:paddingBottom="@dimen/_20sdp">

                <!-- Advanced Filter Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="@dimen/_24sdp"
                        android:layout_height="@dimen/_24sdp"
                        android:src="@drawable/ic_filter_list"
                        app:tint="@color/home_card_title"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_8sdp"
                        android:text="Advanced Filter"
                        android:textColor="@color/home_card_title"
                        android:textSize="@dimen/_16ssp"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Customize your practice"
                    android:textColor="@color/home_card_subtitle"
                    android:textSize="@dimen/_11ssp"
                    android:layout_marginTop="@dimen/_2sdp" />


                <!-- Select Subjects -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="@dimen/_22sdp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Select Subjects"
                        android:textColor="@color/home_card_title"
                        android:textSize="@dimen/_13ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="(Multiple Select)"
                        android:textColor="@color/home_card_subtitle"
                        android:textSize="@dimen/_10ssp" />

                </LinearLayout>


                <!-- Subject RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/subjectRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_220sdp"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:clipToPadding="false"
                    android:overScrollMode="never" />


                <!-- Number of Questions -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Number of Questions"
                    android:textColor="@color/home_card_title"
                    android:textSize="@dimen/_13ssp"
                    android:textStyle="bold"
                    android:layout_marginTop="@dimen/_10sdp" />


                <LinearLayout
                    android:id="@+id/questionCountContainer"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_52sdp"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/countAll"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_42sdp"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/_4sdp"
                        android:text="ALL"
                        android:textColor="@color/home_card_title"
                        android:textSize="@dimen/_11ssp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        app:backgroundTint="@color/home_card_background"
                        app:strokeColor="@color/home_card_border"
                        app:strokeWidth="1dp"
                        app:cornerRadius="@dimen/_8sdp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/count10"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_42sdp"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/_4sdp"
                        android:text="10"
                        android:textColor="@color/home_card_title"
                        android:textSize="@dimen/_11ssp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        app:backgroundTint="@color/home_card_background"
                        app:strokeColor="@color/home_card_border"
                        app:strokeWidth="1dp"
                        app:cornerRadius="@dimen/_8sdp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/count20"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_42sdp"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/_4sdp"
                        android:text="20"
                        android:textColor="@color/home_card_title"
                        android:textSize="@dimen/_11ssp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        app:backgroundTint="@color/home_card_background"
                        app:strokeColor="@color/home_card_border"
                        app:strokeWidth="1dp"
                        app:cornerRadius="@dimen/_8sdp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/count30"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_42sdp"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/_4sdp"
                        android:text="30"
                        android:textColor="@color/home_card_title"
                        android:textSize="@dimen/_11ssp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        app:backgroundTint="@color/home_card_background"
                        app:strokeColor="@color/home_card_border"
                        app:strokeWidth="1dp"
                        app:cornerRadius="@dimen/_8sdp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/count40"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_42sdp"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/_4sdp"
                        android:text="40"
                        android:textColor="@color/home_card_title"
                        android:textSize="@dimen/_11ssp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        app:backgroundTint="@color/home_card_background"
                        app:strokeColor="@color/home_card_border"
                        app:strokeWidth="1dp"
                        app:cornerRadius="@dimen/_8sdp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/count50"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_42sdp"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/_4sdp"
                        android:text="50"
                        android:textColor="@color/home_card_title"
                        android:textSize="@dimen/_11ssp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        app:backgroundTint="@color/home_card_background"
                        app:strokeColor="@color/home_card_border"
                        app:strokeWidth="1dp"
                        app:cornerRadius="@dimen/_8sdp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/count60"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_42sdp"
                        android:layout_weight="1"
                        android:text="60"
                        android:textColor="@color/home_card_title"
                        android:textSize="@dimen/_11ssp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        app:backgroundTint="@color/home_card_background"
                        app:strokeColor="@color/home_card_border"
                        app:strokeWidth="1dp"
                        app:cornerRadius="@dimen/_8sdp"/>

                </LinearLayout>


                <!-- Chapter -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chapter (Optional)"
                    android:textColor="@color/home_card_title"
                    android:textSize="@dimen/_13ssp"
                    android:textStyle="bold"
                    android:layout_marginTop="@dimen/_12sdp" />


                <!-- Time Per Question -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_48sdp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/_8sdp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Time per Question"
                            android:textColor="@color/home_card_title"
                            android:textSize="@dimen/_13ssp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="(Optional)"
                            android:textColor="@color/home_card_subtitle"
                            android:textSize="@dimen/_9ssp" />

                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/timeSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:thumbTint="@color/white"
                        app:trackTint="@color/switch_track_selector" />

                </LinearLayout>


                <!-- Show Explanation -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_48sdp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Show Explanation"
                            android:textColor="@color/home_card_title"
                            android:textSize="@dimen/_13ssp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="(After Answer)"
                            android:textColor="@color/home_card_subtitle"
                            android:textSize="@dimen/_9ssp" />

                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/explanationSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        app:thumbTint="@color/white"
                        app:trackTint="@color/switch_track_selector" />

                </LinearLayout>


                <!-- Start Practice -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/startPracticeButton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_48sdp"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:text="Confirm"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/_13ssp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:backgroundTint="#5B4DE0"
                    app:cornerRadius="@dimen/_9sdp" />

            </LinearLayout>

        </ScrollView>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>