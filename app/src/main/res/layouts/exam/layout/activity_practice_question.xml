<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.exam.PracticeQuestionActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/screen_background">

        <!-- Toolbar -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_58sdp"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/back_arrow_color"
            app:title="Practice MCQ"
            app:titleTextColor="@color/tittle_card"
            app:elevation="0dp" />

        <!-- Top Progress -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_34sdp"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/_18sdp"
            android:paddingEnd="@dimen/_18sdp"
            android:background="@color/home_card_background">

            <!-- Timer -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/timerIcon"
                    android:layout_width="@dimen/_17sdp"
                    android:layout_height="@dimen/_17sdp"
                    android:src="@drawable/ic_timer"
                    android:contentDescription="@null"
                    app:tint="#5B4DE0" />

                <TextView
                    android:id="@+id/timerText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:text="19:45"
                    android:textColor="@color/home_card_subtitle"
                    android:textSize="@dimen/_10ssp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Question Number -->
            <TextView
                android:id="@+id/questionNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5 / 20"
                android:textColor="@color/tittle_card"
                android:textSize="@dimen/_10ssp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Main ScrollView -->
        <ScrollView
            android:id="@+id/nestedScrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/_16sdp"
                android:paddingEnd="@dimen/_16sdp"
                android:paddingTop="@dimen/_12sdp"
                android:paddingBottom="@dimen/_20sdp">

                <!-- Question Container -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:layout_marginBottom="@dimen/_14sdp">

                    <TextView
                        android:id="@+id/questionText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Which of the following is NOT a Noble Gas?"
                        android:textColor="@color/home_card_title"
                        android:textSize="@dimen/_14ssp"
                        android:textStyle="bold"
                        android:lineSpacingExtra="@dimen/_2sdp" />

                    <WebView
                        android:id="@+id/questionWebView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />
                </FrameLayout>

                <!-- Option A -->
                <LinearLayout
                    android:id="@+id/optionA"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/_42sdp"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/_8sdp"
                    android:paddingEnd="@dimen/_10sdp"
                    android:background="@drawable/bg_option_normal">

                    <TextView
                        android:id="@+id/optionALabel"
                        android:layout_width="@dimen/_25sdp"
                        android:layout_height="@dimen/_25sdp"
                        android:gravity="center"
                        android:text="A"
                        android:textColor="#7B8492"
                        android:textSize="@dimen/_10ssp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_option_letter" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/_8sdp">

                        <TextView
                            android:id="@+id/optionAText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Helium (He)"
                            android:textColor="@color/home_card_title"
                            android:textSize="@dimen/_11ssp" />

                        <WebView
                            android:id="@+id/optionAWebView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone" />
                    </FrameLayout>
                </LinearLayout>

                <!-- Option B -->
                <LinearLayout
                    android:id="@+id/optionB"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/_42sdp"
                    android:layout_marginTop="@dimen/_7sdp"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/_8sdp"
                    android:paddingEnd="@dimen/_10sdp"
                    android:background="@drawable/bg_option_normal">

                    <TextView
                        android:id="@+id/optionBLabel"
                        android:layout_width="@dimen/_25sdp"
                        android:layout_height="@dimen/_25sdp"
                        android:gravity="center"
                        android:text="B"
                        android:textColor="#7B8492"
                        android:textSize="@dimen/_10ssp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_option_letter" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/_8sdp">

                        <TextView
                            android:id="@+id/optionBText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Neon (Ne)"
                            android:textColor="@color/home_card_title"
                            android:textSize="@dimen/_11ssp" />

                        <WebView
                            android:id="@+id/optionBWebView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone" />
                    </FrameLayout>
                </LinearLayout>

                <!-- Option C -->
                <LinearLayout
                    android:id="@+id/optionC"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/_42sdp"
                    android:layout_marginTop="@dimen/_7sdp"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/_8sdp"
                    android:paddingEnd="@dimen/_10sdp"
                    android:background="@drawable/bg_option_normal">

                    <TextView
                        android:id="@+id/optionCLabel"
                        android:layout_width="@dimen/_25sdp"
                        android:layout_height="@dimen/_25sdp"
                        android:gravity="center"
                        android:text="C"
                        android:textColor="#7B8492"
                        android:textSize="@dimen/_10ssp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_option_letter" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/_8sdp">

                        <TextView
                            android:id="@+id/optionCText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Chlorine (Cl)"
                            android:textColor="@color/home_card_title"
                            android:textSize="@dimen/_11ssp" />

                        <WebView
                            android:id="@+id/optionCWebView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone" />
                    </FrameLayout>
                </LinearLayout>

                <!-- Option D -->
                <LinearLayout
                    android:id="@+id/optionD"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/_42sdp"
                    android:layout_marginTop="@dimen/_7sdp"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/_8sdp"
                    android:paddingEnd="@dimen/_10sdp"
                    android:background="@drawable/bg_option_normal">

                    <TextView
                        android:id="@+id/optionDLabel"
                        android:layout_width="@dimen/_25sdp"
                        android:layout_height="@dimen/_25sdp"
                        android:gravity="center"
                        android:text="D"
                        android:textColor="#7B8492"
                        android:textSize="@dimen/_10ssp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_option_letter" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/_8sdp">

                        <TextView
                            android:id="@+id/optionDText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Argon (Ar)"
                            android:textColor="@color/home_card_title"
                            android:textSize="@dimen/_11ssp" />

                        <WebView
                            android:id="@+id/optionDWebView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone" />
                    </FrameLayout>
                </LinearLayout>

                <!-- Explanation Layout -->
                <LinearLayout
                    android:id="@+id/explanationLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_16sdp"
                    android:orientation="vertical"
                    android:padding="@dimen/_14sdp"
                    android:background="@drawable/ic_ex">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Explanation"
                        android:textColor="#1858A8"
                        android:textSize="@dimen/_14ssp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_6sdp">

                        <TextView
                            android:id="@+id/explanationText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Velocity-এর SI unit হলো meter per second (m/s)।"
                            android:textColor="@color/home_card_subtitle"
                            android:textSize="@dimen/_13ssp"
                            android:lineSpacingExtra="@dimen/_3sdp" />

                        <WebView
                            android:id="@+id/explanationWebView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone" />
                    </FrameLayout>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- Bottom Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/_10sdp"
            android:paddingEnd="@dimen/_10sdp"
            android:paddingTop="@dimen/_6sdp"
            android:paddingBottom="@dimen/_8sdp"
            android:background="@color/home_card_background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_40sdp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Skip -->
                <LinearLayout
                    android:id="@+id/skipButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_bottom_action"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="@dimen/_15sdp"
                        android:layout_height="@dimen/_15sdp"
                        android:src="@drawable/ic_skip_next"
                        android:contentDescription="@null"
                        app:tint="#57517D" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_4sdp"
                        android:text="Skip"
                        android:textColor="@color/home_card_title"
                        android:textSize="@dimen/_10ssp" />
                </LinearLayout>

                <Space
                    android:layout_width="@dimen/_6sdp"
                    android:layout_height="@dimen/_1sdp" />

                <!-- Report -->
                <LinearLayout
                    android:id="@+id/reportButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_bottom_action"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="@dimen/_15sdp"
                        android:layout_height="@dimen/_15sdp"
                        android:src="@drawable/ic_flag"
                        android:contentDescription="@null"
                        app:tint="#57517D" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_4sdp"
                        android:text="Report"
                        android:textColor="@color/home_card_title"
                        android:textSize="@dimen/_10ssp" />
                </LinearLayout>

                <Space
                    android:layout_width="@dimen/_6sdp"
                    android:layout_height="@dimen/_1sdp" />

                <!-- Next -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/nextButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_weight="2"
                    android:text="Next"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/_10ssp"
                    android:textStyle="bold"
                    android:backgroundTint="#5B4DE0"
                    app:cornerRadius="@dimen/_10sdp" />

            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>