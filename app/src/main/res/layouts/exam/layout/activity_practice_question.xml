<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.exam.PracticeQuestionActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#F8F9FC">

        <!-- Toolbar -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="#5B4DE0"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@android:color/white"
            app:title="Practice MCQ"
            app:titleTextColor="@android:color/white"
            app:elevation="0dp" />

        <!-- Top Progress -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:background="@android:color/white">

            <!-- Timer -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/timerIcon"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:src="@drawable/ic_timer"
                    android:contentDescription="@null"
                    app:tint="#5B4DE0" />

                <TextView
                    android:id="@+id/timerText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="19:45"
                    android:textColor="#555555"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Question Number -->
            <TextView
                android:id="@+id/questionNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5 / 20"
                android:textColor="#3E34B4"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Main ScrollView -->
        <ScrollView
            android:id="@+id/nestedScrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="20dp">

                <!-- Question Container (TextView & WebView উভয়ই থাকবে) -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:id="@+id/questionText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Which of the following is NOT a Noble Gas?"
                        android:textColor="#171717"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:lineSpacingExtra="2dp" />

                    <WebView
                        android:id="@+id/questionWebView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />
                </FrameLayout>

                <!-- Option A -->
                <LinearLayout
                    android:id="@+id/optionA"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="42dp"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="10dp"
                    android:background="@drawable/bg_option_normal">

                    <TextView
                        android:id="@+id/optionALabel"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:gravity="center"
                        android:text="A"
                        android:textColor="#7B8492"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_option_letter" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp">

                        <TextView
                            android:id="@+id/optionAText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Helium (He)"
                            android:textColor="#333333"
                            android:textSize="11sp" />

                        <WebView
                            android:id="@+id/optionAWebView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone" />
                    </FrameLayout>
                </LinearLayout>

                <!-- Option B -->
                <LinearLayout
                    android:id="@+id/optionB"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="42dp"
                    android:layout_marginTop="7dp"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="10dp"
                    android:background="@drawable/bg_option_normal">

                    <TextView
                        android:id="@+id/optionBLabel"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:gravity="center"
                        android:text="B"
                        android:textColor="#7B8492"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_option_letter" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp">

                        <TextView
                            android:id="@+id/optionBText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Neon (Ne)"
                            android:textColor="#333333"
                            android:textSize="11sp" />

                        <WebView
                            android:id="@+id/optionBWebView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone" />
                    </FrameLayout>
                </LinearLayout>

                <!-- Option C -->
                <LinearLayout
                    android:id="@+id/optionC"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="42dp"
                    android:layout_marginTop="7dp"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="10dp"
                    android:background="@drawable/bg_option_normal">

                    <TextView
                        android:id="@+id/optionCLabel"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:gravity="center"
                        android:text="C"
                        android:textColor="#7B8492"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_option_letter" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp">

                        <TextView
                            android:id="@+id/optionCText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Chlorine (Cl)"
                            android:textColor="#333333"
                            android:textSize="11sp" />

                        <WebView
                            android:id="@+id/optionCWebView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone" />
                    </FrameLayout>
                </LinearLayout>

                <!-- Option D -->
                <LinearLayout
                    android:id="@+id/optionD"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="42dp"
                    android:layout_marginTop="7dp"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="10dp"
                    android:background="@drawable/bg_option_normal">

                    <TextView
                        android:id="@+id/optionDLabel"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:gravity="center"
                        android:text="D"
                        android:textColor="#7B8492"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_option_letter" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp">

                        <TextView
                            android:id="@+id/optionDText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Argon (Ar)"
                            android:textColor="#333333"
                            android:textSize="11sp" />

                        <WebView
                            android:id="@+id/optionDWebView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone" />
                    </FrameLayout>
                </LinearLayout>

                <!-- Explanation Layout -->
                <LinearLayout
                    android:id="@+id/explanationLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:background="@drawable/ic_ex">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Explanation"
                        android:textColor="#1858A8"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp">

                        <TextView
                            android:id="@+id/explanationText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Velocity-এর SI unit হলো meter per second (m/s)।"
                            android:textColor="#444444"
                            android:textSize="13sp"
                            android:lineSpacingExtra="3dp" />

                        <WebView
                            android:id="@+id/explanationWebView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone" />
                    </FrameLayout>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- Bottom Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="8dp"
            android:background="@android:color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Skip -->
                <LinearLayout
                    android:id="@+id/skipButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_bottom_action"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_skip_next"
                        android:contentDescription="@null"
                        app:tint="#57517D" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="Skip"
                        android:textColor="#44445B"
                        android:textSize="10sp" />
                </LinearLayout>

                <Space
                    android:layout_width="6dp"
                    android:layout_height="1dp" />

                <!-- Report -->
                <LinearLayout
                    android:id="@+id/reportButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_bottom_action"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_flag"
                        android:contentDescription="@null"
                        app:tint="#57517D" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="Report"
                        android:textColor="#44445B"
                        android:textSize="10sp" />
                </LinearLayout>

                <Space
                    android:layout_width="6dp"
                    android:layout_height="1dp" />

                <!-- Next -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/nextButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="2"
                    android:text="Next"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:backgroundTint="#5B4DE0"
                    app:cornerRadius="10dp" />

            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>