<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.exam.PracticeResultActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/screen_background">

        <!-- Toolbar -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_58sdp"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/back_arrow_color"
            app:title="Result"
            app:titleTextColor="@color/tittle_card"
            app:menu="@menu/result_menu"

            app:elevation="0dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/_16sdp"
                android:paddingEnd="@dimen/_16sdp"
                android:paddingTop="@dimen/_20sdp"
                android:paddingBottom="@dimen/_20sdp">




                <LinearLayout
                    android:id="@+id/resultCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">




                <!-- Result Heading -->
                <TextView
                    android:id="@+id/resultTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="Great Job! 🎉"
                    android:textColor="@color/home_card_title"
                    android:textSize="@dimen/_20ssp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/resultSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:text="You have completed the practice."
                    android:textColor="@color/home_card_subtitle"
                    android:textSize="@dimen/_12ssp" />

                <!-- Score Circle -->
                <FrameLayout
                    android:layout_width="@dimen/_170sdp"
                    android:layout_height="@dimen/_170sdp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/_20sdp">

                    <!-- Background Circle -->
                    <com.example.questionbank_practiceexam.utils.ScoreRingView
                        android:id="@+id/scoreRing"
                        android:layout_width="@dimen/_170sdp"
                        android:layout_height="@dimen/_170sdp" />

                    <!-- Center Content -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Score"
                            android:textColor="@color/home_card_subtitle"
                            android:textSize="@dimen/_14ssp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_2sdp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/scoreText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="16"
                                android:textColor="@color/home_card_title"
                                android:textSize="@dimen/_34ssp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/totalScoreText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_5sdp"
                                android:text="/ 20"
                                android:textColor="@color/home_card_title"
                                android:textSize="@dimen/_20ssp" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/percentageText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_2sdp"
                            android:text="80%"
                            android:textColor="#3DBA82"
                            android:textSize="@dimen/_14ssp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </FrameLayout>

                <!-- Statistics -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_82sdp"
                    android:layout_marginTop="@dimen/_18sdp"
                    android:orientation="horizontal">

                    <!-- Correct -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:background="@drawable/bg_result_correct">

                        <TextView
                            android:layout_width="@dimen/_22sdp"
                            android:layout_height="@dimen/_22sdp"
                            android:gravity="center"
                            android:text="✓"
                            android:textColor="@android:color/white"
                            android:textSize="@dimen/_13ssp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_result_correct_icon" />

                        <TextView
                            android:id="@+id/correctCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_3sdp"
                            android:text="16"
                            android:textColor="@color/home_card_title"
                            android:textSize="@dimen/_14ssp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Correct"
                            android:textColor="@color/home_card_subtitle"
                            android:textSize="@dimen/_10ssp" />

                    </LinearLayout>

                    <Space
                        android:layout_width="@dimen/_7sdp"
                        android:layout_height="1dp" />

                    <!-- Wrong -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:background="@drawable/bg_result_wrong">

                        <TextView
                            android:layout_width="@dimen/_22sdp"
                            android:layout_height="@dimen/_22sdp"
                            android:gravity="center"
                            android:text="×"
                            android:textColor="@android:color/white"
                            android:textSize="@dimen/_15ssp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_result_wrong_icon" />

                        <TextView
                            android:id="@+id/wrongCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_3sdp"
                            android:text="2"
                            android:textColor="@color/home_card_title"
                            android:textSize="@dimen/_14ssp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Wrong"
                            android:textColor="@color/home_card_subtitle"
                            android:textSize="@dimen/_10ssp" />

                    </LinearLayout>

                    <Space
                        android:layout_width="@dimen/_7sdp"
                        android:layout_height="1dp" />

                    <!-- Skipped -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:background="@drawable/bg_result_skipped">

                        <TextView
                            android:layout_width="@dimen/_22sdp"
                            android:layout_height="@dimen/_22sdp"
                            android:gravity="center"
                            android:text="×"
                            android:textColor="@android:color/white"
                            android:textSize="@dimen/_14ssp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_result_skipped_icon" />

                        <TextView
                            android:id="@+id/skippedCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_3sdp"
                            android:text="2"
                            android:textColor="@color/home_card_title"
                            android:textSize="@dimen/_14ssp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Skipped"
                            android:textColor="@color/home_card_subtitle"
                            android:textSize="@dimen/_10ssp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Performance Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_22sdp"
                    android:orientation="vertical"
                    android:padding="@dimen/_12sdp"
                    android:background="@drawable/bg_performance_card">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Performance by Subject"
                        android:textColor="@color/home_card_title"
                        android:textSize="@dimen/_13ssp"
                        android:textStyle="bold" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/subjectPerformanceRecycler"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never" />

                </LinearLayout>

                </LinearLayout>

                <!-- Back Home -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/backHomesButton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_42sdp"
                    android:layout_marginTop="@dimen/_16sdp"
                    android:text="Back Home"
                    android:textAllCaps="false"
                    android:textColor="#5548D2"
                    android:textSize="@dimen/_12ssp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/home_card_background"
                    app:cornerRadius="@dimen/_8sdp"
                    app:strokeColor="@color/home_card_border"
                    app:strokeWidth="1dp" />

                <!-- Practice Again -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/practiceAgainButton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_42sdp"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:text="Practice Again"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/_12ssp"
                    android:textStyle="bold"
                    android:backgroundTint="#5B4DE0"
                    app:cornerRadius="@dimen/_8sdp" />

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>