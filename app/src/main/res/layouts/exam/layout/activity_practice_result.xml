<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.exam.PracticeResultActivity">



    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#F8F9FC">


        <!-- Toolbar -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="58dp"

            android:background="#5B4DE0"

            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@android:color/white"

            app:title="Result"
            app:titleTextColor="@android:color/white"

            app:menu="@menu/result_menu"

            app:elevation="0dp" />


        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"

            android:fillViewport="true"
            android:overScrollMode="never">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="20dp"
                android:paddingBottom="20dp">


                <!-- Result Heading -->

                <TextView
                    android:id="@+id/resultTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_gravity="center_horizontal"

                    android:text="Great Job! 🎉"

                    android:textColor="#171717"
                    android:textSize="20sp"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/resultSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_gravity="center_horizontal"

                    android:layout_marginTop="6dp"

                    android:text="You have completed the practice."

                    android:textColor="#444444"
                    android:textSize="12sp" />


                <!-- Score Circle -->

                <FrameLayout
                    android:layout_width="170dp"
                    android:layout_height="170dp"

                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="20dp">


                    <!-- Background Circle -->

                  <com.example.questionbank_practiceexam.utils.ScoreRingView
                        android:id="@+id/scoreRing"
                        android:layout_width="170dp"
                        android:layout_height="170dp" />
                    <!-- Center Content -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"

                        android:gravity="center"

                        android:orientation="vertical">


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:text="Score"

                            android:textColor="#777B86"
                            android:textSize="14sp" />


                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="2dp"

                            android:gravity="center_vertical"
                            android:orientation="horizontal">


                            <TextView
                                android:id="@+id/scoreText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"

                                android:text="16"

                                android:textColor="#111111"
                                android:textSize="34sp"
                                android:textStyle="bold" />


                            <TextView
                                android:id="@+id/totalScoreText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"

                                android:layout_marginStart="5dp"

                                android:text="/ 20"

                                android:textColor="#222222"
                                android:textSize="20sp" />

                        </LinearLayout>


                        <TextView
                            android:id="@+id/percentageText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="2dp"

                            android:text="80%"

                            android:textColor="#3DBA82"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </FrameLayout>


                <!-- Statistics -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="82dp"

                    android:layout_marginTop="18dp"

                    android:orientation="horizontal">


                    <!-- Correct -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"

                        android:layout_weight="1"

                        android:gravity="center"

                        android:orientation="vertical"

                        android:background="@drawable/bg_result_correct">


                        <TextView
                            android:layout_width="22dp"
                            android:layout_height="22dp"

                            android:gravity="center"

                            android:text="✓"

                            android:textColor="@android:color/white"
                            android:textSize="13sp"
                            android:textStyle="bold"

                            android:background="@drawable/bg_result_correct_icon" />


                        <TextView
                            android:id="@+id/correctCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="3dp"

                            android:text="16"

                            android:textColor="#202020"
                            android:textSize="14sp"
                            android:textStyle="bold" />


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:text="Correct"

                            android:textColor="#444444"
                            android:textSize="10sp" />

                    </LinearLayout>


                    <Space
                        android:layout_width="7dp"
                        android:layout_height="1dp" />


                    <!-- Wrong -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"

                        android:layout_weight="1"

                        android:gravity="center"

                        android:orientation="vertical"

                        android:background="@drawable/bg_result_wrong">


                        <TextView
                            android:layout_width="22dp"
                            android:layout_height="22dp"

                            android:gravity="center"

                            android:text="×"

                            android:textColor="@android:color/white"
                            android:textSize="15sp"
                            android:textStyle="bold"

                            android:background="@drawable/bg_result_wrong_icon" />


                        <TextView
                            android:id="@+id/wrongCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="3dp"

                            android:text="2"

                            android:textColor="#202020"
                            android:textSize="14sp"
                            android:textStyle="bold" />


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:text="Wrong"

                            android:textColor="#444444"
                            android:textSize="10sp" />

                    </LinearLayout>


                    <Space
                        android:layout_width="7dp"
                        android:layout_height="1dp" />


                    <!-- Skipped -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"

                        android:layout_weight="1"

                        android:gravity="center"

                        android:orientation="vertical"

                        android:background="@drawable/bg_result_skipped">


                        <TextView
                            android:layout_width="22dp"
                            android:layout_height="22dp"

                            android:gravity="center"

                            android:text="×"

                            android:textColor="@android:color/white"
                            android:textSize="14sp"
                            android:textStyle="bold"

                            android:background="@drawable/bg_result_skipped_icon" />


                        <TextView
                            android:id="@+id/skippedCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="3dp"

                            android:text="2"

                            android:textColor="#202020"
                            android:textSize="14sp"
                            android:textStyle="bold" />


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:text="Skipped"

                            android:textColor="#444444"
                            android:textSize="10sp" />

                    </LinearLayout>

                </LinearLayout>


                <!-- Performance Card -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:background="@drawable/bg_performance_card">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Performance by Subject"
                        android:textColor="#222222"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/subjectPerformanceRecycler"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never" />

                </LinearLayout>


                <!-- Review Answers -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/backHomesButton"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"

                    android:layout_marginTop="16dp"

                    android:text="Back Home"
                    android:textAllCaps="false"

                    android:textColor="#5548D2"
                    android:textSize="12sp"
                    android:textStyle="bold"

                    android:backgroundTint="@android:color/white"

                    app:cornerRadius="8dp"
                    app:strokeColor="#AFA8F2"
                    app:strokeWidth="1dp" />


                <!-- Practice Again -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/practiceAgainButton"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"

                    android:layout_marginTop="8dp"

                    android:text="Practice Again"
                    android:textAllCaps="false"

                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"

                    android:backgroundTint="#5B4DE0"

                    app:cornerRadius="8dp" />

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>