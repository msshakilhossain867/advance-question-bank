<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:background="#5B4DE0"
    android:layout_height="match_parent"
    tools:context=".presentation.exam.ReviewStartActivity">


    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#F8F9FC">


        <!-- Toolbar -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="#5B4DE0"

            app:title="Review &amp; Start"
            app:titleTextColor="@android:color/white"

            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@android:color/white"

            app:elevation="0dp" />


        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"

            android:fillViewport="true"
            android:overScrollMode="never">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="20dp"
                android:paddingBottom="24dp">


                <!-- Review Icon -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center_horizontal"

                    app:cardBackgroundColor="#F0EFFF"
                    app:cardCornerRadius="32dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_gravity="center"

                        android:src="@drawable/ic_review"
                        android:contentDescription="@null" />

                </com.google.android.material.card.MaterialCardView>


                <!-- Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="10dp"

                    android:text="Your Selections"

                    android:textColor="#181818"
                    android:textSize="15sp"
                    android:textStyle="bold" />


                <!-- Subjects -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="horizontal"
                    android:gravity="center_vertical"

                    android:paddingTop="20dp"
                    android:paddingBottom="14dp">


                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_weight="1"

                        android:text="Subjects"
                        android:textColor="#292929"
                        android:textSize="13sp" />


                    <TextView
                        android:id="@+id/selectedSubjectsText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_weight="1.25"

                        android:gravity="end"

                        android:text="Physics, Chemistry,\nMathematics"

                        android:textColor="#5546D8"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEEEF2" />


                <!-- Number of Questions -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="55dp"

                    android:orientation="horizontal"
                    android:gravity="center_vertical">


                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_weight="1"

                        android:text="Number of Questions"
                        android:textColor="#292929"
                        android:textSize="13sp" />


                    <TextView
                        android:id="@+id/selectedQuestionCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="20"

                        android:textColor="#5546D8"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEEEF2" />





                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEEEF2" />





                <!-- Time -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="55dp"

                    android:orientation="horizontal"
                    android:gravity="center_vertical">


                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_weight="1"

                        android:text="Time per Question"
                        android:textColor="#292929"
                        android:textSize="13sp" />


                    <TextView
                        android:id="@+id/selectedTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="Not Set"

                        android:textColor="#444444"
                        android:textSize="12sp" />

                </LinearLayout>


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEEEF2" />


                <!-- Explanation -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="55dp"

                    android:orientation="horizontal"
                    android:gravity="center_vertical">


                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_weight="1"

                        android:text="Show Explanation"
                        android:textColor="#292929"
                        android:textSize="13sp" />


                    <TextView
                        android:id="@+id/selectedExplanation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="Yes"

                        android:textColor="#44446F"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <!-- Info Box -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="horizontal"
                    android:gravity="center_vertical"

                    android:padding="11dp"

                    android:layout_marginTop="12dp"

                    android:background="@drawable/bg_practice_info">


                    <!-- Info Icon -->
                    <TextView
                        android:layout_width="22dp"
                        android:layout_height="22dp"

                        android:gravity="center"

                        android:text="i"

                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"

                        android:background="@drawable/bg_info_circle" />


                    <TextView
                        android:id="@+id/infoText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_weight="1"

                        android:layout_marginStart="8dp"

                        android:text="You will get 20 random MCQ based on your selection."

                        android:textColor="#4B4B68"
                        android:textSize="11sp"

                        android:lineSpacingExtra="2dp" />

                </LinearLayout>


                <!-- Start Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/startPracticeButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"

                    android:layout_marginTop="18dp"

                    android:text="▶  Start Practice"
                    android:textAllCaps="false"

                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"

                    android:backgroundTint="#5B4DE0"

                    app:cornerRadius="9dp" />

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>