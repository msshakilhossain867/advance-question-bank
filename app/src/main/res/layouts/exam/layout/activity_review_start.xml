<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#5B4DE0"
    tools:context=".presentation.exam.ReviewStartActivity">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/screen_background">


        <!-- Toolbar -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_58sdp"
            android:background="#5B4DE0"
            app:title="Review &amp; Start"
            app:titleTextColor="@android:color/white"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@android:color/white"
            app:elevation="0dp" />


        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/_16sdp"
                android:paddingEnd="@dimen/_16sdp"
                android:paddingTop="@dimen/_20sdp"
                android:paddingBottom="@dimen/_24sdp">


                <!-- Review Icon -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="@dimen/_64sdp"
                    android:layout_height="@dimen/_64sdp"
                    android:layout_gravity="center_horizontal"
                    app:cardBackgroundColor="@color/home_card_background"
                    app:cardCornerRadius="@dimen/_32sdp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/home_card_border"
                    app:strokeWidth="1dp">

                    <ImageView
                        android:layout_width="@dimen/_42sdp"
                        android:layout_height="@dimen/_42sdp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_review"
                        android:contentDescription="@null" />

                </com.google.android.material.card.MaterialCardView>


                <!-- Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:text="Your Selections"
                    android:textColor="@color/home_card_title"
                    android:textSize="@dimen/_15ssp"
                    android:textStyle="bold" />


                <!-- Subjects -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="@dimen/_20sdp"
                    android:paddingBottom="@dimen/_14sdp">


                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Subjects"
                        android:textColor="@color/home_card_title"
                        android:textSize="@dimen/_13ssp" />


                    <TextView
                        android:id="@+id/selectedSubjectsText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.25"
                        android:gravity="end"
                        android:text="Physics, Chemistry,\nMathematics"
                        android:textColor="#5546D8"
                        android:textSize="@dimen/_11ssp"
                        android:textStyle="bold" />

                </LinearLayout>


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/home_card_border" />


                <!-- Number of Questions -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_55sdp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">


                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Number of Questions"
                        android:textColor="@color/home_card_title"
                        android:textSize="@dimen/_13ssp" />


                    <TextView
                        android:id="@+id/selectedQuestionCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="20"
                        android:textColor="#5546D8"
                        android:textSize="@dimen/_13ssp"
                        android:textStyle="bold" />

                </LinearLayout>


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/home_card_border" />


                <!-- Time -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_55sdp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">


                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Time per Question"
                        android:textColor="@color/home_card_title"
                        android:textSize="@dimen/_13ssp" />


                    <TextView
                        android:id="@+id/selectedTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Not Set"
                        android:textColor="@color/home_card_subtitle"
                        android:textSize="@dimen/_12ssp" />

                </LinearLayout>


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/home_card_border" />


                <!-- Explanation -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_55sdp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">


                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Show Explanation"
                        android:textColor="@color/home_card_title"
                        android:textSize="@dimen/_13ssp" />


                    <TextView
                        android:id="@+id/selectedExplanation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Yes"
                        android:textColor="@color/home_card_title"
                        android:textSize="@dimen/_12ssp"
                        android:textStyle="bold" />

                </LinearLayout>


                <!-- Info Box -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/_11sdp"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:background="@drawable/bg_practice_info">


                    <!-- Info Icon -->
                    <TextView
                        android:layout_width="@dimen/_22sdp"
                        android:layout_height="@dimen/_22sdp"
                        android:gravity="center"
                        android:text="i"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/_13ssp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_info_circle" />


                    <TextView
                        android:id="@+id/infoText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/_8sdp"
                        android:text="You will get 20 random MCQ based on your selection."
                        android:textColor="@color/home_card_subtitle"
                        android:textSize="@dimen/_11ssp"
                        android:lineSpacingExtra="@dimen/_2sdp" />

                </LinearLayout>


                <!-- Start Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/startPracticeButton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_50sdp"
                    android:layout_marginTop="@dimen/_18sdp"
                    android:text="▶  Start Practice"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/_14ssp"
                    android:textStyle="bold"
                    android:backgroundTint="#5B4DE0"
                    app:cornerRadius="@dimen/_9sdp" />

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>