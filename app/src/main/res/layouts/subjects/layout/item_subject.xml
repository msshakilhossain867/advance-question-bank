<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/subjectCard"
    android:layout_width="match_parent"
    android:layout_height="@dimen/_64sdp"
    android:layout_margin="@dimen/_8sdp"
    android:layout_marginBottom="@dimen/_4sdp"
    app:cardCornerRadius="@dimen/_9sdp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="#E21E1E"
    app:strokeColor="@color/home_card_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/_10sdp"
        android:paddingEnd="@dimen/_10sdp">

        <!-- Subject Icon -->
        <ImageView
            android:id="@+id/subjectIcon"
            android:layout_width="@dimen/_38sdp"
            android:layout_height="@dimen/_38sdp"
            android:padding="@dimen/_8sdp"
            android:src="@drawable/physics_subject_icon"
            app:tint="@android:color/white"
            android:scaleType="centerInside"
            android:contentDescription="@null"
            android:background="@drawable/bg_subject_icon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/_14sdp"
            android:layout_weight="1">

            <!-- Subject Name -->
            <TextView
                android:id="@+id/subjectName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Physics"
                android:textColor="@color/white"
                android:textSize="@dimen/_16ssp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subjectSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Physics"
                android:textColor="#F0B0B0"
                android:textSize="@dimen/_11ssp"
                android:textStyle="normal|italic" />

        </LinearLayout>

        <!-- Arrow -->
        <ImageView
            android:id="@+id/arrowIcon"
            android:layout_width="@dimen/_28sdp"
            android:layout_height="@dimen/_28sdp"
            android:padding="@dimen/_5sdp"
            android:src="@drawable/ic_arrow_forward"
            app:tint="@color/white"
            android:contentDescription="@null" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>