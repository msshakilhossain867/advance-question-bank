<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".presentation.fragments.SettingsFragment"
    android:fillViewport="true"
    android:background="@color/screen_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/_16sdp">

        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="@color/home_text_primary"
            android:textSize="@dimen/_20ssp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:text="Customize your practice experience"
            android:textColor="@color/home_card_subtitle"
            android:textSize="@dimen/_11ssp" />


        <!-- ================================================= -->
        <!-- PREFERENCES -->
        <!-- ================================================= -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_25sdp"
            android:text="PREFERENCES"
            android:textColor="@color/home_card_title"
            android:textSize="@dimen/_12ssp"
            android:textStyle="bold" />


        <!-- Dark Mode -->
        <LinearLayout
            android:id="@+id/darkModeSetting"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_64sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:background="@drawable/bg_progress_card"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/_15sdp">

            <TextView
                android:layout_width="@dimen/_44sdp"
                android:layout_height="@dimen/_44sdp"
                android:background="@drawable/bg_setting_icon"
                android:gravity="center"
                android:text="🌙"
                android:textSize="@dimen/_20ssp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_12sdp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dark Mode"
                    android:textColor="@color/home_card_title"
                    android:textSize="@dimen/_14ssp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:text="Use dark appearance"
                    android:textColor="@color/home_card_subtitle"
                    android:textSize="@dimen/_11ssp" />

            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/darkModeSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>


        <!-- Daily Mission Notification -->
        <LinearLayout
            android:id="@+id/missionNotificationSetting"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_64sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:background="@drawable/bg_progress_card"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/_15sdp">

            <TextView
                android:layout_width="@dimen/_44sdp"
                android:layout_height="@dimen/_44sdp"
                android:background="@drawable/bg_setting_icon"
                android:gravity="center"
                android:text="🔔"
                android:textSize="@dimen/_20ssp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_12sdp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Daily Mission"
                    android:textColor="@color/home_card_title"
                    android:textSize="@dimen/_11ssp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/missionNotificationStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:text="Mission reminder notifications"
                    android:textColor="@color/home_card_subtitle"
                    android:textSize="@dimen/_12ssp" />

            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/missionNotificationSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>


