        <!-- ================================================= -->
        <!-- PROGRESS -->
        <!-- ================================================= -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_27sdp"
            android:text="PROGRESS"
            android:textColor="@color/home_card_title"
            android:textSize="@dimen/_12ssp"
            android:textStyle="bold" />


        <!-- Statistics -->
        <LinearLayout
            android:id="@+id/statisticsSetting"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_64sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:background="@drawable/bg_progress_card"
            android:gravity="center_vertical"
            android:visibility="visible"
            android:paddingHorizontal="@dimen/_15sdp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="@dimen/_44sdp"
                android:layout_height="@dimen/_44sdp"
                android:background="@drawable/bg_setting_icon"
                android:gravity="center"
                android:text="📊"
                android:textSize="@dimen/_20ssp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_12sdp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Progress &amp; Statistics"
                    android:textColor="@color/home_card_title"
                    android:textSize="@dimen/_11ssp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:text="View your practice performance"
                    android:textColor="@color/home_card_subtitle"
                    android:textSize="@dimen/_12ssp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="@color/home_card_subtitle"
                android:textSize="@dimen/_28ssp" />

        </LinearLayout>


        <!-- Clear Progress -->
        <LinearLayout
            android:id="@+id/clearProgressSetting"
            android:layout_width="match_parent"
            android:visibility="visible"
            android:layout_height="@dimen/_64sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:background="@drawable/bg_progress_card"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/_15sdp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="@dimen/_44sdp"
                android:layout_height="@dimen/_44sdp"
                android:background="@drawable/bg_setting_icon"
                android:gravity="center"
                android:text="🗑️"
                android:textSize="@dimen/_19ssp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_12sdp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Clear Progress"
                    android:textColor="#D32F2F"
                    android:textSize="@dimen/_11ssp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:text="Reset your practice statistics"
                    android:textColor="@color/home_card_subtitle"
                    android:textSize="@dimen/_12ssp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="@color/home_card_subtitle"
                android:textSize="@dimen/_28ssp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- APP -->
        <!-- ================================================= -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_27sdp"
            android:text="APP"
            android:textColor="@color/home_card_title"
            android:textSize="@dimen/_12ssp"
            android:textStyle="bold" />


        <!-- Rate App -->
        <LinearLayout
            android:id="@+id/rateAppSetting"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_64sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:background="@drawable/bg_progress_card"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/_15sdp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="@dimen/_44sdp"
                android:layout_height="@dimen/_44sdp"
                android:background="@drawable/bg_setting_icon"
                android:gravity="center"
                android:text="⭐"
                android:textSize="@dimen/_20ssp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_12sdp"
                android:layout_weight="1"
                android:text="Rate Us"
                android:textColor="@color/home_card_title"
                android:textSize="@dimen/_11ssp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="@color/home_card_subtitle"
                android:textSize="@dimen/_28ssp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/shareAppSetting"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_64sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:background="@drawable/bg_progress_card"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/_15sdp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="@dimen/_44sdp"
                android:layout_height="@dimen/_44sdp"
                android:background="@drawable/bg_setting_icon"
                android:padding="@dimen/_8sdp"
                android:gravity="center"
                android:src="@drawable/ic_share"
                app:tint="#FBD735"
                android:textSize="@dimen/_20ssp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_12sdp"
                android:layout_weight="1"
                android:text="Share"
                android:textColor="@color/home_card_title"
                android:textSize="@dimen/_11ssp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="@color/home_card_subtitle"
                android:textSize="@dimen/_28ssp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/policyAppSetting"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_64sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:background="@drawable/bg_progress_card"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/_15sdp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="@dimen/_44sdp"
                android:layout_height="@dimen/_44sdp"
                android:background="@drawable/bg_setting_icon"
                android:gravity="center"
                android:text="🔐"
                android:textSize="@dimen/_20ssp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_12sdp"
                android:layout_weight="1"
                android:text="Privacy Policy"
                android:textColor="@color/home_card_title"
                android:textSize="@dimen/_11ssp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="@color/home_card_subtitle"
                android:textSize="@dimen/_28ssp" />

        </LinearLayout>


        <!-- About -->
        <LinearLayout
            android:id="@+id/aboutSetting"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_64sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:background="@drawable/bg_progress_card"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/_15sdp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="@dimen/_44sdp"
                android:layout_height="@dimen/_44sdp"
                android:background="@drawable/bg_setting_icon"
                android:gravity="center"
                android:text="ℹ️"
                android:textSize="@dimen/_20ssp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_12sdp"
                android:layout_weight="1"
                android:text="About App"
                android:textColor="@color/home_card_title"
                android:textSize="@dimen/_11ssp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="@color/home_card_subtitle"
                android:textSize="@dimen/_28ssp" />

        </LinearLayout>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_25sdp"
            android:layout_marginBottom="@dimen/_20sdp"
            android:gravity="center"
            android:text="Question Bank Practice Exam\nVersion 1.0"
            android:textColor="@color/home_card_subtitle"
            android:textSize="@dimen/_11ssp" />

    </LinearLayout>

</ScrollView>