<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="@dimen/_15sdp"
    android:layout_marginBottom="@dimen/_8sdp"
    android:background="@drawable/bg_white_card">

    <!-- Unread Dot -->
    <View
        android:id="@+id/unreadDot"
        android:layout_width="@dimen/_8sdp"
        android:layout_height="@dimen/_8sdp"
        android:layout_marginEnd="@dimen/_12sdp"
        android:background="@drawable/bg_unread_dot"/>

    <!-- Content -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notificationTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Daily Mission Reminder"
            android:textSize="@dimen/_15ssp"
            android:textStyle="bold"
            android:textColor="@color/home_card_title"/>

        <TextView
            android:id="@+id/notificationMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:text="Complete today's missions."
            android:textSize="@dimen/_13ssp"
            android:textColor="@color/home_card_subtitle"/>

        <TextView
            android:id="@+id/notificationTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:text="17 Aug, 05:00 PM"
            android:textSize="@dimen/_11ssp"
            android:textColor="@color/home_card_subtitle"/>

    </LinearLayout>

    <!-- Read Indicator/Icon -->
    <TextView
        android:id="@+id/readIcon"
        android:layout_width="@dimen/_32sdp"
        android:layout_height="@dimen/_32sdp"
        android:gravity="center"
        android:text="✓"
        android:textSize="@dimen/_18ssp"
        android:textStyle="bold"
        android:textColor="#2E7D32"
        android:visibility="gone"/>

</LinearLayout>