<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/_11sdp">

        <!-- Header -->
        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Daily Mission"
            android:textSize="@dimen/_22ssp"
            android:textStyle="bold"
            android:textColor="@color/home_text_primary"/>

        <TextView
            android:id="@+id/subtitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:text="Complete today's missions"
            android:textSize="@dimen/_12ssp"
            android:textColor="@color/home_card_subtitle"/>


        <!-- Overall Progress -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_20sdp"
            android:orientation="vertical"
            android:padding="@dimen/_16sdp"
            android:background="@drawable/bg_progress_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/progressTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Today's Progress"
                    android:textSize="@dimen/_13ssp"
                    android:textStyle="bold"
                    android:textColor="@color/home_card_title"/>

                <TextView
                    android:id="@+id/progressPercentText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textSize="@dimen/_16ssp"
                    android:textStyle="bold"
                    android:textColor="@color/home_card_title"/>

            </LinearLayout>

            <ProgressBar
                android:id="@+id/overallProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_8sdp"
                android:layout_marginTop="@dimen/_12sdp"
                android:max="100"
                android:progress="0"/>

            <TextView
                android:id="@+id/progressCountText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:text="0 of 5 missions completed"
                android:textSize="@dimen/_11ssp"
                android:textColor="@color/home_card_subtitle"/>

        </LinearLayout>


        <!-- Mission List -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_26sdp"
            android:text="Today's Missions"
            android:textSize="@dimen/_16ssp"
            android:textStyle="bold"
            android:textColor="@color/home_text_primary"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/missionRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:nestedScrollingEnabled="false"/>


        <!-- All Completed -->
        <LinearLayout
            android:id="@+id/allCompletedCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_20sdp"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/_24sdp"
            android:visibility="gone"
            android:background="@drawable/bg_progress_card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎉"
                android:textSize="@dimen/_40ssp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:text="All Missions Completed!"
                android:textSize="@dimen/_20ssp"
                android:textStyle="bold"
                android:textColor="@color/home_card_title"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:text="Great job! You completed today's goals."
                android:textSize="@dimen/_14ssp"
                android:textColor="@color/home_card_subtitle"
                android:gravity="center"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>